<!-- vexor-template: id=json-field-match; title=Match a JSON field; description=Alert when a JSON field from a custom app decoder has a given value (pair with decoders/json-app-logs.xml) -->
<!-- Wazuh ruleset. Change the IDs if you use several templates: custom IDs are 100100-100199. -->
<!--
  decoded_as names the decoder that handled the event. Here it is the custom
  JSON decoder vexor-json-app from decoders/json-app-logs.xml. Use the decoder
  name from your own decoder file.
  JSON keys are fields. "action" is a built-in field with its own tag (<action>);
  any other key uses <field name="key">, e.g. <field name="user.role">admin</field>.
-->
<group name="vexor,json,">
  <rule id="100105" level="8">
    <decoded_as>vexor-json-app</decoded_as>
    <action type="pcre2">^(delete|purge)$</action>
    <description>App: destructive action $(action)</description>
  </rule>
</group>
