<!-- vexor-template: id=web-access-log; title=Custom web access log; description=Decode a common-format web access log read straight from a file (no syslog header) -->
<!--
  Read the access log file with a localfile entry (log_format syslog takes the
  raw line). The regex expects the common log format: client, identity, user,
  [time], "method url protocol", status, size. It has no prematch, so it is
  tried on every line that reaches it. Change the regex when your format adds fields.
-->
<decoder name="vexor-web-access">
  <regex>^(\S+) \S+ \S+ \[\S+ \S+\] "(\w+) (\S+) \S+" (\d+) (\d+)</regex>
  <order>srcip,protocol,url,id,size</order>
</decoder>
