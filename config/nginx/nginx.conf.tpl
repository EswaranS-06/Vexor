# Rendered into nginx.conf by scripts/scale.sh - edit this template, not nginx.conf.
user  nginx;
worker_processes  auto;

error_log  /var/log/nginx/error.log warn;
pid        /var/run/nginx.pid;

events {
    worker_connections  __NGINX_WORKER_CONNECTIONS__;
}

# ---------------------------------------------------------------
#  HTTPS reverse proxy: https://<host>:8080  ->  Wazuh dashboard
#  (container port is fixed at 8080; change the host port with PROXY_PORT in .env)
# ---------------------------------------------------------------
http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;

    log_format  main  '$remote_addr - $remote_user [$time_local] "$request" '
                      '$status $body_bytes_sent "$http_referer" '
                      '"$http_user_agent" "$http_x_forwarded_for"';

    # nginx logs go to the container's stdout/stderr -> rotated by Docker (LOG_MAX_SIZE/LOG_MAX_FILE)
    access_log  /dev/stdout  main;

    sendfile        on;
    tcp_nopush      on;
    keepalive_timeout  65;
    server_tokens   off;
    gzip            on;

    map $http_upgrade $connection_upgrade {
        default upgrade;
        ''      close;
    }

    server {
        listen 8080 ssl;
        # plain http:// sent to this https port -> redirect instead of "400 Bad Request"
        error_page 497 =301 https://$http_host$request_uri;
        server_name _;

        # Reuses the dashboard certificate generated by setup.sh.
        # Swap these two files for your own CA-signed cert if you have one.
        ssl_certificate     /etc/nginx/certs/proxy.pem;
        ssl_certificate_key /etc/nginx/certs/proxy-key.pem;
        ssl_protocols       TLSv1.2 TLSv1.3;

        client_max_body_size 50m;

        location / {
            proxy_pass https://wazuh.dashboard:5601;
            proxy_ssl_verify off;                # internal hop to the dashboard's self-signed cert
            proxy_http_version 1.1;
            proxy_set_header Host              $host:$server_port;
            proxy_set_header X-Real-IP         $remote_addr;
            proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header Upgrade           $http_upgrade;
            proxy_set_header Connection        $connection_upgrade;
            proxy_read_timeout 300s;
        }
    }
    # optional web tools (N8N/GRAFANA/PORTAINER=true in .env) - rendered by vexor
__TOOL_SERVERS__
}

# ---------------------------------------------------------------
#  TCP load balancer for agent events (port 1514) across the managers
# ---------------------------------------------------------------
stream {
    upstream wazuh_cluster {
        hash $remote_addr consistent;
        server wazuh.master:1514;
__WORKER_UPSTREAMS__
    }
    server {
        listen 1514;
        proxy_pass wazuh_cluster;
    }
}
