NORMALISE = r"""// Vexor: accept only calls that carry the token, then give every source the same shape.
const TOKEN = '%s';
const isPublic = (ip) => !!ip && /^\d+\.\d+\.\d+\.\d+$/.test(ip) && !/^(10\.|127\.|169\.254\.|192\.168\.|172\.(1[6-9]|2\d|3[01])\.|0\.)/.test(ip);
const out = [];
for (const item of $input.all()) {
  const h = item.json.headers || {};
  if (h['x-vexor-token'] !== TOKEN) continue;              // not from Vexor: drop it
  const a = item.json.body || {};
  let source = 'other', level = 0, title = '', where = '', srcip = '', agent_id = '';
  if (a.rule) {                                           // Wazuh alert (also Suricata/Zeek seen by Wazuh, Vexor health)
    source = (a.rule.groups || []).includes('health') ? 'vexor-health' : 'wazuh';
    level = Number(a.rule.level || 0); title = a.rule.description || '';
    where = (a.agent || {}).name || ''; agent_id = (a.agent || {}).id || '';
    const d = a.data || {};
    srcip = d.srcip || d.src_ip || (d['id.orig_h']) || '';
  } else if (a.event_type === 'alert' && a.alert) {       // Suricata eve alert (SOC=elk, via Logstash)
    source = 'suricata'; level = ({1: 12, 2: 7, 3: 4})[a.alert.severity] || 3;
    title = a.alert.signature || ''; where = `${a.src_ip}:${a.src_port} -> ${a.dest_ip}:${a.dest_port}`; srcip = a.src_ip || '';
  } else if (a.note) {                                    // Zeek notice (SOC=elk, via Logstash)
    source = 'zeek'; level = 6; title = `${a.note}: ${a.msg || ''}`; where = a['id.orig_h'] || a.src || ''; srcip = a['id.orig_h'] || a.src || '';
  }
  const severity = level >= 12 ? 'critical' : level >= 7 ? 'high' : level >= 4 ? 'medium' : 'low';
  out.push({ json: { source, severity, level, title, where, srcip, srcip_public: isPublic(srcip), agent_id,
                     rule_id: (a.rule || {}).id || '', time: a.timestamp || a['@timestamp'] || new Date().toISOString(), alert: a } });
}
return out;""" % token

