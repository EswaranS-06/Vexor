print("\n".join(f["name"] for f in json.load(sys.stdin).get("files", []) if f.get("source") == "wazuh"))' 2>/dev/null
  return 0
}
det_ovr_has() { grep -qxF -- "$1/$2" "$DET_OVR" 2>/dev/null; }
