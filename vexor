}
securityadmin_users() {        # push internal_users.yml into the running indexer cluster
  dc exec -T wazuh1.indexer bash -c '
    export JAVA_HOME=/usr/share/wazuh-indexer/jdk
    D=/usr/share/wazuh-indexer/config
