n8n_credentials() {            # least-privilege users n8n workflows use to act on / read the stacks
  take_lock
  if soc_wazuh; then
    api_login || die "Wazuh API not reachable"
    local user pw rid uid pol ro
    user="$(env_def WAZUH_N8N_USER vexor-n8n)"; pw="$(gen_pw)"
    [[ "$user" =~ ^[A-Za-z0-9._@-]{4,64}$ ]] || die "WAZUH_N8N_USER=$user - Wazuh user names are 4-64 letters, digits or . _ @ -"
    pol="$(api GET "/security/policies?limit=500" | pj '
want = {"agents_read_agents", "agents_all_agents", "agents_commands_agents", "syscheck_all_syscheck"}
print(",".join(str(p["id"]) for p in d["data"]["affected_items"] if p["name"] in want))')"
    [ -n "$pol" ] || die "could not read the Wazuh RBAC policies"
    rid="$(api GET "/security/roles?limit=500" | pj 'print(next((r["id"] for r in d["data"]["affected_items"] if r["name"] == "vexor_n8n"), ""))')"
    [ -n "$rid" ] || rid="$(api POST /security/roles -d '{"name":"vexor_n8n"}' | pj 'print(d["data"]["affected_items"][0]["id"])')" || die "could not create the role vexor_n8n"
    api POST "/security/roles/$rid/policies?policy_ids=$pol" >/dev/null
    uid="$(api GET "/security/users?limit=500" | pj 'print(next((u["id"] for u in d["data"]["affected_items"] if u["username"] == sys.argv[1]), ""))' "$user")"
    if [ -n "$uid" ]; then api PUT "/security/users/$uid" -d "{\"password\":\"$pw\"}" | has '"error": *0' || die "could not reset the password of '$user'"
    else
      api POST /security/users -d "{\"username\":\"$user\",\"password\":\"$pw\"}" > "$RUN_TMP/n8n-user.json"
      uid="$(pj 'print(d["data"]["affected_items"][0]["id"])' < "$RUN_TMP/n8n-user.json" 2>/dev/null)"         || die "could not create the Wazuh API user '$user': $(head -c 300 "$RUN_TMP/n8n-user.json")"
    fi
    ro="$(api GET "/security/roles?limit=500" | pj 'print(next((r["id"] for r in d["data"]["affected_items"] if r["name"] == "readonly"), ""))')"
    api POST "/security/users/$uid/roles?role_ids=${ro:+$ro,}$rid" >/dev/null
    env_set WAZUH_N8N_USER "$user"; env_set WAZUH_N8N_PASSWORD "$pw"; chmod 600 "$ENV_FILE"
    local c; c="$(curl -sk -o /dev/null -w '%{http_code}' -X POST -u "$user:$pw" "https://$(local_ip):$(api_port)/security/user/authenticate?raw=true")"
    [ "$c" = 200 ] || die "Wazuh API user created but its login fails (HTTP $c)"
    hdr "n8n credential: Wazuh API (agents, active response, syscheck)"
    say "1. HTTP Request node -> POST https://wazuh.master:55000/security/user/authenticate?raw=true"
    say "   Authentication: Basic auth  user $user  password $pw   |  Settings: Ignore SSL issues = on"
    say "2. use the returned token as header  Authorization: Bearer <token>  for e.g."
    say "   PUT https://wazuh.master:55000/active-response?agents_list=<id>   GET https://wazuh.master:55000/agents?status=active"
  fi
  if soc_elk; then
    gen_secret ES_N8N_PASSWORD
    es_curl PUT /_security/role/vexor_n8n_read -d '{"cluster":["monitor"],"indices":[{"names":["vexor-*"],"privileges":["read","view_index_metadata"]}]}' >/dev/null
    es_curl PUT /_security/user/vexor_n8n -d "{\"password\":\"$(env_get ES_N8N_PASSWORD)\",\"roles\":[\"vexor_n8n_read\"],\"full_name\":\"Vexor n8n reader\"}" \
      | has '"created"' || die "could not create the Elasticsearch user vexor_n8n"
    hdr "n8n credential: Elasticsearch (read vexor-*)"
    say "Elasticsearch node or HTTP Request: http://elasticsearch:9200   user vexor_n8n   password $(env_get ES_N8N_PASSWORD)"
  fi
  n8n_import_credentials || true
  hint "passwords are stored in .env (WAZUH_N8N_PASSWORD, ES_N8N_PASSWORD); in n8n they are the credentials 'Vexor - Wazuh API' / 'Vexor - Elasticsearch'"
}
