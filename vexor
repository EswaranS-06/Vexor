#!/usr/bin/env bash
# =============================================================================
#  vexor - CLI for Vexor: a Docker SOC stack (Wazuh, ELK or both) with optional tools
#
#  Lives next to docker-compose.yml and .env (.env holds every setting).
#      ./vexor help              every command
#      ./vexor install           first-time setup (safe to re-run)
#      ./vexor node-type single|multi   switch the layout; agents, alerts and settings are kept
#      ./vexor daemon install    `vexor` on PATH + systemd service/timers
# =============================================================================
set -uo pipefail

VEXOR_VERSION="2.2.0"
SELF="$(readlink -f "${BASH_SOURCE[0]}")"
ROOT="$(dirname "$SELF")"

# The code lives in lib/ next to this file (ROOT follows symlinks, so /usr/local/bin/vexor works too).
# Modules are sourced at top level, in this fixed order: the order of the former single file.
for _vexor_mod in 01-core.sh 02-env.sh 03-docker.sh 04-passwords-nginx.sh 05-install.sh 06-status.sh 07-certs.sh 08-proxy.sh 09-cluster.sh 10-tools.sh 11-elk.sh 12-health.sh 13-n8n.sh 14-sensors.sh 15-detection.sh 16-data.sh 17-lifecycle.sh 18-daemon.sh 19-console.sh 20-main.sh; do
  [ -r "$ROOT/lib/$_vexor_mod" ] || { echo "vexor: $ROOT/lib/$_vexor_mod is missing - vexor needs its lib/ directory" >&2; exit 1; }
done; unset _vexor_mod
# shellcheck source=lib/01-core.sh
. "$ROOT/lib/01-core.sh"
# shellcheck source=lib/02-env.sh
. "$ROOT/lib/02-env.sh"
# shellcheck source=lib/03-docker.sh
. "$ROOT/lib/03-docker.sh"
# shellcheck source=lib/04-passwords-nginx.sh
. "$ROOT/lib/04-passwords-nginx.sh"
# shellcheck source=lib/05-install.sh
. "$ROOT/lib/05-install.sh"
# shellcheck source=lib/06-status.sh
. "$ROOT/lib/06-status.sh"
# shellcheck source=lib/07-certs.sh
. "$ROOT/lib/07-certs.sh"
# shellcheck source=lib/08-proxy.sh
. "$ROOT/lib/08-proxy.sh"
# shellcheck source=lib/09-cluster.sh
. "$ROOT/lib/09-cluster.sh"
# shellcheck source=lib/10-tools.sh
. "$ROOT/lib/10-tools.sh"
# shellcheck source=lib/11-elk.sh
. "$ROOT/lib/11-elk.sh"
# shellcheck source=lib/12-health.sh
. "$ROOT/lib/12-health.sh"
# shellcheck source=lib/13-n8n.sh
. "$ROOT/lib/13-n8n.sh"
# shellcheck source=lib/14-sensors.sh
. "$ROOT/lib/14-sensors.sh"
# shellcheck source=lib/15-detection.sh
. "$ROOT/lib/15-detection.sh"
# shellcheck source=lib/16-data.sh
. "$ROOT/lib/16-data.sh"
# shellcheck source=lib/17-lifecycle.sh
. "$ROOT/lib/17-lifecycle.sh"
# shellcheck source=lib/18-daemon.sh
. "$ROOT/lib/18-daemon.sh"
# shellcheck source=lib/19-console.sh
. "$ROOT/lib/19-console.sh"
# shellcheck source=lib/20-main.sh
. "$ROOT/lib/20-main.sh"

main "$@"
