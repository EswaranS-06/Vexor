grafana_user_ok() {
  local c; c="$(curl -sS -o /dev/null -w '%{http_code}' --connect-timeout 5 --cacert "$INT_CERT_DIR/root-ca.pem" \
    --resolve "wazuh1.indexer:$(indexer_port):$(env_def INDEXER_BIND 127.0.0.1 | sed 's/^0.0.0.0$/127.0.0.1/')" \
    -u "grafana:$(env_get GRAFANA_INDEXER_PASSWORD)" "$(indexer_base)/wazuh-alerts-*/_mapping" 2>/dev/null)"
