  for a in "$@"; do [ "$a" = --json ] && json=1 || rest+=("$a"); done
  set -- "${rest[@]}"
  soc_wazuh || die "Wazuh is off (SOC=$(soc))"
  local master="$CLUSTER_DIR/wazuh_manager.conf"
  case "$verb" in
    ls|list|show)
