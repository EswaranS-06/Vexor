# ============================================================== retention / logs pruning
retention_apply() {
  local days body resp seq pri
  days="$(env_def INDEX_RETENTION_DAYS 90)"
  [[ "$days" =~ ^[0-9]+$ ]] && [ "$days" -ge 1 ] || die "INDEX_RETENTION_DAYS must be a positive number"
  body="$(cat <<JSON
{"policy":{"description":"Delete Wazuh alert/archive indices after ${days} days","default_state":"hot",
 "states":[{"name":"hot","actions":[],"transitions":[{"state_name":"delete","conditions":{"min_index_age":"${days}d"}}]},
           {"name":"delete","actions":[{"delete":{}}],"transitions":[]}],
 "ism_template":[{"index_patterns":["wazuh-alerts-*","wazuh-archives-*"],"priority":100}]}}
JSON
)"
  resp="$(ix GET "/_plugins/_ism/policies/$ISM_POLICY")"
  seq="$(pj 'print(d.get("_seq_no","") if "policy" in d else "")' <<<"$resp" || true)"
  pri="$(pj 'print(d.get("_primary_term","") if "policy" in d else "")' <<<"$resp" || true)"
  if [ -n "$seq" ]; then
    ix PUT "/_plugins/_ism/policies/$ISM_POLICY?if_seq_no=$seq&if_primary_term=$pri" -d "$body" >/dev/null || return 1
    ok "retention policy updated: delete alert/archive indices after $days days"
  else
    ix PUT "/_plugins/_ism/policies/$ISM_POLICY" -d "$body" | has '"_id"' || return 1
    ok "retention policy created: delete alert/archive indices after $days days"
  fi
  local pat
  for pat in 'wazuh-alerts-*' 'wazuh-archives-*'; do
    ix POST "/_plugins/_ism/add/$pat" -d "{\"policy_id\":\"$ISM_POLICY\"}" >/dev/null 2>&1 || true
  done
  # existing indices keep the policy version they were attached with: move them to the new one
  for pat in 'wazuh-alerts-*' 'wazuh-archives-*'; do
    ix POST "/_plugins/_ism/change_policy/$pat" -d "{\"policy_id\":\"$ISM_POLICY\"}" >/dev/null 2>&1 || true
  done
  return 0
}
cmd_retention() {
  case "${1:-show}" in
    apply) take_lock; [ "$(ix_code)" = 200 ] || die "indexer unreachable"; retention_apply ;;
    show)
      [ "$(ix_code)" = 200 ] || die "indexer unreachable"
      say "INDEX_RETENTION_DAYS=$(env_def INDEX_RETENTION_DAYS 90)   MANAGER_LOG_RETENTION_DAYS=$(env_def MANAGER_LOG_RETENTION_DAYS 30)   SNAPSHOT_RETENTION_DAYS=$(env_def SNAPSHOT_RETENTION_DAYS 14)"
      if [ "$(ix_code "/_plugins/_ism/policies/$ISM_POLICY")" = 200 ]; then ok "ISM policy '$ISM_POLICY' present"; else warn "ISM policy missing (vexor retention apply)"; fi
      hdr "Alert / archive indices (oldest first)"
      ix GET "/_cat/indices/wazuh-alerts-*,wazuh-archives-*?v&s=index&h=index,docs.count,store.size,creation.date.string" | head -n 60
      hdr "Total size"
      ix GET "/_cat/indices/wazuh-*?h=store.size&bytes=b" | awk '{s+=$1} END {printf "  %.2f GB (all wazuh-* indices, incl. replicas)\n", s/1073741824}' ;;
    *) die "usage: vexor retention show|apply  (set INDEX_RETENTION_DAYS first: vexor config set INDEX_RETENTION_DAYS 60)" ;;
  esac
}
prune_logs() {
  local days svc; days="$(env_def MANAGER_LOG_RETENTION_DAYS 30)"
  for svc in $(enabled_managers); do
    is_running "$svc" || continue
    say "[$svc] deleting rotated logs older than $days days"
    dc exec -T "$svc" bash -c "
      for d in alerts archives firewall api cluster; do
        [ -d /var/ossec/logs/\$d ] && find /var/ossec/logs/\$d -type f \( -name '*.gz' -o -name '*.json' -o -name '*.log' -o -name '*.sum' \) \
          -mtime +$days -print -delete
      done; true" | sed 's/^/    /'
  done
}

# ============================================================== backup / restore
ES_SNAP_REPO="vexor-backup"
es_snapshot_dir() { local d; d="$(backup_dir)/es-snapshots"; mkdir -p "$d"; chown 1000:0 "$d"; chmod 770 "$d"; echo "$d"; }
es_snapshot_register() {
  es_snapshot_dir >/dev/null
  es_curl PUT "/_snapshot/$ES_SNAP_REPO" -d '{"type":"fs","settings":{"location":"/usr/share/elasticsearch/snapshots","compress":true}}' 2>/dev/null | has '"acknowledged":true'
}
es_snapshot_run() {            # es_snapshot_run <stamp>: vexor-* + Kibana saved objects (data views, dashboards)
  soc_elk || return 0
  [ "$(es_code /_cluster/health)" = 200 ] || { warn "Elasticsearch not reachable - ELK snapshot skipped"; return 1; }
  es_snapshot_register || { bad "Elasticsearch snapshot repository could not be registered (path.repo; recreate elasticsearch: vexor restart elasticsearch)"; return 1; }
  local r st
  r="$(es_curl PUT "/_snapshot/$ES_SNAP_REPO/es-snap-$1?wait_for_completion=true" --max-time 7200 \
        -d '{"indices":"vexor-*","ignore_unavailable":true,"include_global_state":false,"feature_states":["kibana"]}' 2>/dev/null)"
  st="$(pj 'print(d.get("snapshot",{}).get("state","FAILED"))' <<<"$r" 2>/dev/null || echo FAILED)"
  if [ "$st" = SUCCESS ]; then ok "Elasticsearch snapshot es-snap-$1 (vexor-* + Kibana saved objects)"
  else bad "Elasticsearch snapshot: $st $(head -c 300 <<<"$r")"; return 1; fi
}
es_snapshot_prune() {          # es_snapshot_prune <cutoff-epoch>
  soc_elk && [ "$(es_code "/_snapshot/$ES_SNAP_REPO")" = 200 ] || return 0
  es_curl GET "/_snapshot/$ES_SNAP_REPO/_all" 2>/dev/null | pj '
for s in d.get("snapshots", []):
    if int(s.get("end_time_in_millis", 0)) // 1000 < int(sys.argv[1]): print(s["snapshot"])' "$1" | while read -r id; do
    [ -n "$id" ] && es_curl DELETE "/_snapshot/$ES_SNAP_REPO/$id" >/dev/null 2>&1 && say "pruned Elasticsearch snapshot $id"
  done
}
snapshot_register() {
  local dir; dir="$(backup_dir)/snapshots"; mkdir -p "$dir"; chown 1000:1000 "$dir"
  ix PUT "/_snapshot/$SNAP_REPO" -d '{"type":"fs","settings":{"location":"/mnt/snapshots","compress":true}}' | has '"acknowledged":true'
}
backup_run() {
  local keep dir stamp p vol r state
  keep="$(env_def SNAPSHOT_RETENTION_DAYS 14)"; dir="$(backup_dir)"; stamp="$(date +%Y%m%d-%H%M%S)"; p="$(project)"
  mkdir -p "$dir/config" "$dir/snapshots"
  hdr "Backup $stamp -> $dir"
  if [ "$(ix_code)" = 200 ]; then
    snapshot_register || warn "snapshot repository registration failed"
    r="$(ix PUT "/_snapshot/$SNAP_REPO/snap-$stamp?wait_for_completion=true" --max-time 7200 \
          -d '{"indices":"wazuh-*","ignore_unavailable":true,"include_global_state":false}')"
    state="$(pj 'print(d.get("snapshot",{}).get("state","FAILED"))' <<<"$r" || echo FAILED)"
    if [ "$state" = SUCCESS ]; then ok "indexer snapshot snap-$stamp"
    else bad "indexer snapshot: $state $(head -c 300 <<<"$r")"; fi
  else
    warn "indexer unreachable - snapshot skipped"
  fi
  for vol in "${MASTER_STATE_VOLUMES[@]}" n8n-data grafana-data portainer-data; do
    docker volume inspect "${p}_${vol}" >/dev/null 2>&1 || continue
    docker run --rm -v "${p}_${vol}:/data:ro" -v "$dir/config:/backup" "$ALPINE_IMAGE" \
      tar czf "/backup/${vol}-${stamp}.tar.gz" -C /data . && ok "volume $vol"
  done
  es_snapshot_run "$stamp" || true
  tar czf "$dir/config/stack-config-${stamp}.tar.gz" -C "$ROOT" config .env docker-compose.yml generate-indexer-certs.yml vexor 2>/dev/null \
    && ok "stack config (.env, config/, certs)"
  chmod 600 "$dir"/config/*"${stamp}"* 2>/dev/null
  # retention
  find "$dir/config" -name '*.tar.gz' -mtime "+$keep" -print -delete | sed 's/^/  pruned /'
  if [ "$(ix_code)" = 200 ]; then
    local cutoff; cutoff=$(date -d "-${keep} days" +%s)
    ix GET "/_cat/snapshots/$SNAP_REPO?h=id,end_epoch&format=json" | pj '
for s in d:
    if int(s.get("end_epoch") or 0) < int(sys.argv[1]): print(s["id"])' "$cutoff" | while read -r id; do
      [ -n "$id" ] && ix DELETE "/_snapshot/$SNAP_REPO/$id" >/dev/null && say "pruned snapshot $id"
    done
  fi
  es_snapshot_prune "$(date -d "-${keep} days" +%s)"
  ok "backup $stamp done (keeping $keep days)"
}
cmd_backup() {
  local sub="${1:-run}"; shift || true
  case "$sub" in
    run|now)  take_lock; backup_run ;;
    register) take_lock; snapshot_register && ok "snapshot repository '$SNAP_REPO' registered" || die "failed (is the indexer up?)" ;;
    list|ls)
      hdr "Indexer snapshots"
      if [ "$(ix_code)" = 200 ]; then ix GET "/_cat/snapshots/$SNAP_REPO?v&h=id,status,start_time,duration,indices,total_shards"; else warn "indexer unreachable"; fi
      if soc_elk && [ "$(es_code "/_snapshot/$ES_SNAP_REPO")" = 200 ]; then
        hdr "Elasticsearch snapshots"
        es_curl GET "/_cat/snapshots/$ES_SNAP_REPO?v&h=id,status,start_time,duration,indices" 2>/dev/null
      fi
      hdr "Config / manager backups ($(backup_dir)/config)"
      ls -1t "$(backup_dir)/config" 2>/dev/null | head -n 40 | sed 's/^/  /'
      hint "restore: vexor backup restore-snapshot <id> | restore-manager <stamp> | restore-config <file>" ;;
    restore-snapshot)
      local snap="${1:-}" idx="wazuh-alerts-*,wazuh-archives-*" rename=0; shift || true
      while [ $# -gt 0 ]; do case "$1" in --indices) idx="${2:?}"; shift ;; --rename) rename=1 ;; esac; shift; done
      [ -n "$snap" ] || die "usage: vexor backup restore-snapshot <snapshot-id> [--indices 'wazuh-alerts-4.x-2026.10.*'] [--rename]"
      [ "$rename" = 1 ] || warn "indices that already exist and are open will make the restore fail - use --rename to restore as restored-<name>"
      confirm "Restore $idx from $snap?" || die "Aborted"
      take_lock
      local body; body="$(python3 -I -c 'import json,sys
b={"indices":sys.argv[1],"ignore_unavailable":True,"include_global_state":False,"include_aliases":False}
if sys.argv[2]=="1": b.update(rename_pattern="(.+)", rename_replacement="restored-$1")
print(json.dumps(b))' "$idx" "$rename")"
      ix POST "/_snapshot/$SNAP_REPO/$snap/_restore?wait_for_completion=true" --max-time 7200 -d "$body" | pretty ;;
    restore-es)
      soc_elk || die "ELK is off (SOC=$(soc))"
      local snap="${1:-}" idx="vexor-*" rename=0 kib=0; shift || true
      while [ $# -gt 0 ]; do case "$1" in --indices) idx="${2:?}"; shift ;; --rename) rename=1 ;; --kibana) kib=1 ;; esac; shift; done
      [ -n "$snap" ] || die "usage: vexor backup restore-es <es-snap-id> [--indices 'vexor-zeek-*'] [--rename] [--kibana]   (ids: vexor backup list)"
      [ "$rename" = 1 ] || warn "open indices with the same name make the restore fail - use --rename to restore as restored-<name>"
      confirm "Restore $idx$( [ "$kib" = 1 ] && echo ' and the Kibana saved objects') from $snap?" || die "Aborted"
      take_lock
      local body; body="$(python3 -I -c 'import json,sys
b={"indices":sys.argv[1],"ignore_unavailable":True,"include_global_state":False,"include_aliases":False}
if sys.argv[2]=="1": b.update(rename_pattern="(.+)", rename_replacement="restored-$1")
b["feature_states"]=["kibana"] if sys.argv[3]=="1" else ["none"]
print(json.dumps(b))' "$idx" "$rename" "$kib")"
      es_curl POST "/_snapshot/$ES_SNAP_REPO/$snap/_restore?wait_for_completion=true" --max-time 7200 -d "$body" | pretty ;;
    restore-manager)
      local stamp="${1:-}" dir f vol; dir="$(backup_dir)/config"
      [ -n "$stamp" ] || die "usage: vexor backup restore-manager <stamp>   (e.g. 20261015-013000, see: vexor backup list)"
      ls "$dir"/*-"$stamp".tar.gz >/dev/null 2>&1 || die "no backups with stamp $stamp in $dir"
      confirm_word RESTORE "Overwrites the master's agent keys, rules, decoders, groups and API config with backup $stamp." || die "Aborted"
      take_lock
      dc stop wazuh.master
      for vol in "${MASTER_STATE_VOLUMES[@]}"; do
        f="$dir/${vol}-${stamp}.tar.gz"; [ -f "$f" ] || continue
        vol_restore_raw "$(project)_${vol}" "$f" && ok "restored $vol"
      done
      dc up -d wazuh.master && ok "master restarted" ;;
    restore-config)
      local file="${1:-}"; [ -f "$file" ] || die "usage: vexor backup restore-config <stack-config-STAMP.tar.gz>"
      confirm_word RESTORE "Overwrites .env, config/ (incl. certificates) and docker-compose.yml with $file." || die "Aborted"
      take_lock
      local pre; pre="$(backup_dir)/config/stack-config-pre-restore-$(date +%Y%m%d-%H%M%S).tar.gz"
      tar czf "$pre" -C "$ROOT" config .env docker-compose.yml && chmod 600 "$pre" && ok "current config saved to $pre"
      tar xzf "$file" -C "$ROOT" --exclude=vexor && ok "config restored - apply with: vexor restart" ;;
    *) die "usage: vexor backup [run]|list|register|restore-snapshot|restore-manager|restore-config" ;;
  esac
}

# ============================================================== volumes
vol_full() { case "$1" in "$(project)"_*) echo "$1" ;; *) echo "$(project)_$1" ;; esac; }
vol_users() { docker ps -a --filter "volume=$1" --format '{{.Names}}' 2>/dev/null | tr '\n' ' '; }
vol_restore_raw() {
  docker run --rm -v "$1:/data" -v "$(dirname "$2"):/backup:ro" "$ALPINE_IMAGE" \
    sh -c 'find /data -mindepth 1 -delete && tar xzf "/backup/$1" -C /data' _ "$(basename "$2")"
}
project_volumes() { docker volume ls -q --filter "label=com.docker.compose.project=$(project)" 2>/dev/null | sort; }
cmd_volumes() {
  local sub="${1:-ls}"; shift || true
  case "$sub" in
    ls|list)
      printf '  %-44s %9s  %s\n' VOLUME SIZE "USED BY"
      local v mp
      for v in $(project_volumes); do
        mp="$(docker volume inspect -f '{{.Mountpoint}}' "$v")"
        printf '  %-44s %9s  %s\n' "$v" "$(du -sh "$mp" 2>/dev/null | cut -f1)" "$(vol_users "$v")"
      done
      hint "location: $(docker_root)/volumes" ;;
    backup)
      local target="${1:-}" stop=0 out stamp v vols=(); shift || true
      while [ $# -gt 0 ]; do case "$1" in --stop) stop=1 ;; --out) out="${2:?}"; shift ;; esac; shift; done
      [ -n "$target" ] || die "usage: vexor volumes backup <volume|all> [--stop] [--out DIR]"
      take_lock
      stamp="$(date +%Y%m%d-%H%M%S)"; out="${out:-$(backup_dir)/volumes/$stamp}"; mkdir -p "$out"
      if [ "$target" = all ]; then mapfile -t vols < <(project_volumes); else vols=("$(vol_full "$target")"); fi
      if [ "$stop" = 0 ] && running_services | has .; then
        warn "containers are running: indexer data copied live may be inconsistent (use --stop, or 'vexor backup' for snapshots)"
      fi
      [ "$stop" = 1 ] && { touch "$STATE_DIR/stopped"; dc_all stop; }
      for v in "${vols[@]}"; do
        docker volume inspect "$v" >/dev/null 2>&1 || { bad "no such volume $v"; continue; }
        docker run --rm -v "$v:/data:ro" -v "$out:/backup" "$ALPINE_IMAGE" tar czf "/backup/$v.tar.gz" -C /data . \
          && ok "$v -> $out/$v.tar.gz ($(du -h "$out/$v.tar.gz" | cut -f1))"
      done
      chmod 600 "$out"/*.tar.gz 2>/dev/null
      [ "$stop" = 1 ] && { rm -f "$STATE_DIR/stopped"; dc up -d >/dev/null && ok "stack started again"; } ;;
    restore)
      local v f users; v="$(vol_full "${1:-}")"; f="${2:-}"
      [ -n "${1:-}" ] && [ -f "$f" ] || die "usage: vexor volumes restore <volume> <file.tar.gz>"
      users="$(vol_users "$v")"
      confirm_word RESTORE "Replaces all content of $v with $f${users:+ (stops: $users)}." || die "Aborted"
      take_lock
      local c; for c in $users; do docker stop "$c" >/dev/null; done
      docker volume inspect "$v" >/dev/null 2>&1 || docker volume create --label "com.docker.compose.project=$(project)" "$v" >/dev/null
      vol_restore_raw "$v" "$(readlink -f "$f")" && ok "restored $v"
      for c in $users; do docker start "$c" >/dev/null; done ;;
    rm|remove)
      local v users; v="$(vol_full "${1:-}")"; [ -n "${1:-}" ] || die "usage: vexor volumes rm <volume>"
      users="$(vol_users "$v")"; [ -z "$users" ] || die "$v is used by: $users (stop/remove those first)"
      confirm_word DELETE "Permanently deletes volume $v." || die "Aborted"
      docker volume rm "$v" && ok "removed $v" ;;
    prune)
      local n i v cand=(); n="$(worker_count)"
      for i in 2 3; do
        [ "$n" -ge "$i" ] && continue
        for v in $(project_volumes | grep "_worker${i}-"); do [ -z "$(vol_users "$v")" ] && cand+=("$v"); done
      done
      [ ${#cand[@]} -gt 0 ] || { ok "nothing to prune (only volumes of disabled workers are candidates)"; return 0; }
      printf '  %s\n' "${cand[@]}"
      confirm_word DELETE "Deletes the volumes above (workers disabled by WORKER_COUNT=$n)." || die "Aborted"
      docker volume rm "${cand[@]}" >/dev/null && ok "removed ${#cand[@]} volume(s)" ;;
    *) die "usage: vexor volumes ls | backup <vol|all> [--stop] [--out DIR] | restore <vol> <file> | rm <vol> | prune" ;;
  esac
}

# ============================================================== reset
cmd_reset() {
  local level="${1:-}"; level="${level#--}"
  if [ -z "$level" ]; then
    [ -t 0 ] || die "usage: vexor reset containers|data|full|purge"
    cat <<EOF
  1) containers  remove containers + network; all data kept            (like: down)
  2) data        + delete ALL volumes: agents, alerts, indices, manager state
  3) full        + new certificates, passwords and cluster key (fresh install; local dashboard CA is kept)
  4) purge       + remove systemd units and Wazuh images (backups are never deleted)
EOF
    local a; read -r -p "  Choose 1-4: " a
    case "$a" in 1) level=containers ;; 2) level=data ;; 3) level=full ;; 4) level=purge ;; *) die "Aborted" ;; esac
  fi
  case "$level" in containers|data|full|purge) ;; *) die "usage: vexor reset containers|data|full|purge" ;; esac
  if [ "$level" = containers ]; then cmd_down; return; fi

  confirm_word DELETE "reset '$level' permanently deletes all Wazuh data on this host (agents, alerts, indices, manager rules)." || die "Aborted"
  take_lock
  if [ "$(ix_code)" = 200 ] && [ "$ASSUME_YES" = 0 ] && confirm "Take a backup first (recommended)?"; then backup_run; fi
  mkdir -p "$STATE_DIR"; touch "$STATE_DIR/stopped"
  hdr "Removing containers and volumes"
  dc_all down -v --remove-orphans
  local v left; left="$(project_volumes)"
  for v in $left; do docker volume rm "$v" >/dev/null 2>&1 && say "removed $v"; done
  # the next install bootstraps a new indexer cluster for NODE_TYPE in .env
  rm -f "$NODE_TYPE_FILE" "$NODE_SWITCH_FILE" "$STATE_DIR/indexer-cluster-excluded" "$STATE_DIR/indexer-replicas.saved"
  ok "data deleted (next install uses NODE_TYPE=$(desired_node_type) from .env)"

  if [ "$level" = full ] || [ "$level" = purge ]; then
    hdr "Resetting certificates, passwords, cluster key"
    local bk; bk="$(backup_dir)/reset-$(date +%Y%m%d-%H%M%S)"; mkdir -p "$bk"
    cp -a "$ENV_FILE" "$bk/.env"
    [ -d "$INT_CERT_DIR" ] && mv "$INT_CERT_DIR" "$bk/" && mkdir -p "$INT_CERT_DIR"
    cp -a "$INTERNAL_USERS" "$DASH_WAZUH_YML" "$bk/" 2>/dev/null
    local k; for k in INDEXER_PASSWORD DASHBOARD_PASSWORD API_PASSWORD; do env_set "$k" CHANGE_ME; done
    env_set AGENT_ENROLL_PASSWORD ""
    sed -i 's#<use_password>yes</use_password>#<use_password>no</use_password>#' "$CLUSTER_DIR/wazuh_manager.conf"
    ensure_cluster_key new >/dev/null
    rm -f "$STATE_DIR/passwords-applied" "$STATE_DIR/previous_version"
    ok "old .env + certificates saved in $bk"
  fi
  if [ "$level" = purge ]; then
    hdr "Purging"
    daemon_uninstall
    docker image rm "wazuh/wazuh-manager:$(cur_version)" "wazuh/wazuh-indexer:$(cur_version)" "wazuh/wazuh-dashboard:$(cur_version)" \
      "$(env_def NGINX_IMAGE nginx:stable)" wazuh/wazuh-certs-generator:0.0.4 2>/dev/null | sed 's/^/  /'
    ok "purged (backups kept in $(backup_dir))"
  fi
  rm -f "$STATE_DIR/stopped"
  say ""
  say "Start fresh with: ${C_BD}vexor install${C_0}"
}

# ============================================================== update
latest_versions() {            # stable 4.x versions, newest first
  local out
  out="$(curl -fsSL --max-time 15 "https://api.github.com/repos/wazuh/wazuh-docker/releases?per_page=100" 2>/dev/null | python3 -I -c '
import json, re, sys
vs = set()
for r in json.load(sys.stdin):
    if r.get("draft") or r.get("prerelease"): continue
    m = re.fullmatch(r"v?(4)\.(\d+)\.(\d+)", r.get("tag_name", ""))
    if m: vs.add(tuple(map(int, m.groups())))
for v in sorted(vs, reverse=True): print("%d.%d.%d" % v)' 2>/dev/null)"
  if [ -z "$out" ]; then
    out="$(curl -fsSL --max-time 15 "https://hub.docker.com/v2/repositories/wazuh/wazuh-manager/tags?page_size=100&name=4." 2>/dev/null | python3 -I -c '
import json, re, sys
vs = {tuple(map(int, t["name"].split("."))) for t in json.load(sys.stdin).get("results", []) if re.fullmatch(r"4\.\d+\.\d+", t["name"])}
for v in sorted(vs, reverse=True): print("%d.%d.%d" % v)' 2>/dev/null)"
  fi
  printf '%s\n' "$out" | sed '/^$/d'
}
cmd_update() {
  local sub="${1:-check}"; shift || true
  case "$sub" in
    check)
      local cur latest newer; cur="$(cur_version)"
      say "Configured version : $cur"
      is_running wazuh.master && say "Running managers   : $(dc exec -T wazuh.master /var/ossec/bin/wazuh-control info -v 2>/dev/null | tr -d '\r')"
      latest="$(latest_versions)"
      [ -n "$latest" ] || die "Could not reach GitHub/Docker Hub to check versions"
      newer="$(awk -v c="$cur" 'BEGIN{split(c,a,".")} {split($0,b,"."); if (b[1]*1e6+b[2]*1e3+b[3] > a[1]*1e6+a[2]*1e3+a[3]) print}' <<<"$latest")"
      say "Latest stable 4.x  : $(head -1 <<<"$latest")"
      if [ -n "$newer" ]; then
        warn "Update available: $(tr '\n' ' ' <<<"$newer")"
        say "Release notes: https://github.com/wazuh/wazuh-docker/releases/tag/v$(head -1 <<<"$newer")"
        if [ -t 0 ] && [ "$ASSUME_YES" = 0 ] && confirm "Upgrade to $(head -1 <<<"$newer") now?"; then update_apply "$(head -1 <<<"$newer")"; fi
      else
        ok "Up to date"
      fi ;;
    apply|upgrade) update_apply "$@" ;;
    rollback)
      local prev; prev="$(cat "$STATE_DIR/previous_version" 2>/dev/null)"; [ -n "$prev" ] || die "No previous version recorded"
      warn "Rolling back to $prev. If the indexer already migrated its data to the newer version it may refuse to start;"
      warn "in that case restore indices from the snapshot taken before the upgrade (vexor backup list)."
      confirm "Roll back $(cur_version) -> $prev?" || die "Aborted"
      take_lock
      env_set WAZUH_VERSION "$prev"; rm -f "$STATE_DIR/previous_version"
      dc_all down && dc up -d && wait_indexer 300 && wait_dashboard 240 ;;
    images|pull)
      take_lock
      hdr "Re-pulling images for $(cur_version) + $(env_def NGINX_IMAGE nginx:stable)"
      dc pull && dc up -d && ok "containers recreated only where the image changed"
      docker image prune -f >/dev/null ;;
    *) die "usage: vexor update [check] | apply [VERSION|latest] [--no-backup] [--force] | rollback | images" ;;
  esac
}
update_apply() {
  local target="" force=0 nobackup=0 cur
  while [ $# -gt 0 ]; do case "$1" in --force) force=1 ;; --no-backup) nobackup=1 ;; *) target="$1" ;; esac; shift; done
  cur="$(cur_version)"
  if [ -z "$target" ] || [ "$target" = latest ]; then
    target="$(latest_versions | head -1)"
    [ -n "$target" ] || die "Could not determine the latest version - pass one: vexor update apply 4.14.9"
  fi
  target="${target#v}"
  [[ "$target" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || die "Version must look like 4.14.9"
  [ "$target" = "$cur" ] && { ok "Already on $cur"; return 0; }
  if ver_gt "$cur" "$target" && [ "$force" = 0 ]; then
    die "Downgrade $cur -> $target is not supported by the indexer. Use 'update rollback' right after a failed upgrade, or --force."
  fi
  if [ "${target%%.*}" != 4 ] && [ "$force" = 0 ]; then
    die "$target is not 4.x. Major upgrades change the deployment layout - follow the official migration guide."
  fi
  hdr "Upgrade Wazuh $cur -> $target"
  say "Release notes: https://github.com/wazuh/wazuh-docker/releases/tag/v$target"
  [ "$(cut -d. -f1,2 <<<"$cur")" != "$(cut -d. -f1,2 <<<"$target")" ] && \
    warn "Minor version change: compare config/ with the v$target files in wazuh/wazuh-docker (multi-node/config) for new settings."
  confirm "Continue? The stack is down for a few minutes" || die "Aborted"
  take_lock
  hdr "Pulling images (before any downtime)"
  local img; for img in wazuh-manager wazuh-indexer wazuh-dashboard; do
    docker pull -q "wazuh/$img:$target" || die "image wazuh/$img:$target not available"
  done
  docker pull -q "$(env_def NGINX_IMAGE nginx:stable)" >/dev/null || warn "nginx image pull failed (keeping current)"
  if [ "$nobackup" = 0 ]; then
    if [ "$(ix_code)" = 200 ]; then backup_run || { confirm "Backup failed. Continue anyway?" || die "Aborted"; }
    else confirm "Indexer unreachable - continue WITHOUT a backup?" || die "Aborted"; fi
  fi
  mkdir -p "$STATE_DIR"; echo "$cur" > "$STATE_DIR/previous_version"
  env_set WAZUH_VERSION "$target"
  sed -i -E "s/(CERT_TOOL_VERSION=)[0-9.]+/\1$(cut -d. -f1,2 <<<"$target")/" "$CERTGEN_FILE"
  hdr "Restarting on $target"
  dc_all down && render_nginx && dc up -d || die "start failed - roll back with: vexor update rollback"
  if wait_stack; then
    post_start
    ok "Upgraded to $target"
    is_running wazuh.master && dc exec -T wazuh.master /var/ossec/bin/cluster_control -l
    say "Agents can be upgraded from the dashboard (Agents -> Upgrade) or: vexor api PUT '/agents/upgrade?agents_list=all'"
  else
    bad "Stack not healthy after upgrade - inspect: vexor doctor | roll back: vexor update rollback"
    return 1
  fi
}

# ============================================================== daemon / watchdog / maintenance
cmd_watchdog() {
  take_lock quiet
  docker_ok || { log "docker daemon not running"; exit 1; }
  [ -f "$STATE_DIR/stopped" ] && exit 0
  grep -qE '^(INDEXER|DASHBOARD|API)_PASSWORD=CHANGE_ME' "$ENV_FILE" && exit 0
  local heal; heal="$(env_def WATCHDOG_AUTOHEAL yes)"
  local svc run started=""; run="$(running_services)"
  for svc in $(enabled_services); do
    grep -qx "$svc" <<<"$run" && continue
    if [ "$heal" = yes ]; then log "$svc not running - starting it"; dc up -d "$svc" >/dev/null 2>&1 && started+="$svc " || log "failed to start $svc"
    else log "$svc not running (WATCHDOG_AUTOHEAL=no)"; started+="$svc(down) "; fi
  done
  if [ -n "$started" ] && [ "$(env_def NOTIFY_ON fail)" != off ] && ! file_fresh "$STATE_DIR/notify.watchdog" 60; then
    notify_send warn "Vexor on $(hostname): watchdog acted" "Containers that were not running: $started" && touch "$STATE_DIR/notify.watchdog"
  fi
  local dp warn_pct; warn_pct="$(env_def DISK_WARN_PCT 85)"; dp="$(disk_pct "$(docker_root)")"
  [ "${dp:-0}" -ge "$warn_pct" ] && log "WARNING docker disk ${dp}% used"
  if [ "$(ix_code)" = 200 ]; then
    local st; st="$(ix GET /_cluster/health | pj 'print(d["status"])')"
    [ "$st" = green ] || log "indexer cluster is $st"
    local ro; ro="$(ix GET '/_all/_settings/index.blocks.read_only_allow_delete' | pj 'print(sum(1 for v in d.values() if v.get("settings",{}).get("index",{}).get("blocks",{}).get("read_only_allow_delete") == "true"))')"
    if [ "${ro:-0}" -gt 0 ]; then
      if [ "$heal" = yes ] && [ "${dp:-100}" -lt 90 ]; then
        ix PUT '/_all/_settings' -d '{"index.blocks.read_only_allow_delete": null}' >/dev/null && log "cleared read-only block on $ro indices (disk ${dp}%)"
      else log "WARNING $ro indices read-only (disk ${dp}%)"; fi
    fi
  elif grep -qx wazuh1.indexer <<<"$run"; then
    log "indexer not answering (HTTP $(ix_code))"
  fi
  local pc; pc="$(proxy_code)"
  [[ "$pc" =~ ^(200|302)$ ]] || log "dashboard on port $(env_def PROXY_PORT 8080) ($(proxy_svc)) returns HTTP ${pc:-000}"
  node_type_pending && log "NODE_TYPE=$(pending_target) in .env, running $(node_type) - run: vexor node-type $(pending_target)"
  return 0
}
cmd_maintenance() {
  take_lock quiet
  log "maintenance start"
  prune_logs
  tools_maintenance
  [ "$(ix_code)" = 200 ] && retention_apply
  cert_renew
  docker image prune -f >/dev/null 2>&1
  log "maintenance done"
}
daemon_units() {
  local bt mt; bt="$(env_def BACKUP_TIME 01:30)"; mt="$(env_def MAINT_TIME 02:15)"
  cat > "$SYSTEMD_DIR/$UNIT.service" <<EOF
[Unit]
Description=Wazuh multi-node Docker stack ($ROOT)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=$ROOT
ExecStart=$SELF --quiet --no-color start
ExecStop=$SELF --quiet --no-color stop
TimeoutStartSec=900
TimeoutStopSec=300

[Install]
WantedBy=multi-user.target
EOF
  local name desc cmd cal rep
  while IFS='|' read -r name desc cmd cal rep; do
    cat > "$SYSTEMD_DIR/$UNIT-$name.service" <<EOF
[Unit]
Description=Wazuh stack: $desc
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
WorkingDirectory=$ROOT
ExecStart=$SELF --no-color $cmd
EOF
    cat > "$SYSTEMD_DIR/$UNIT-$name.timer" <<EOF
[Unit]
Description=Wazuh stack: $desc

[Timer]
$cal
${rep:+OnUnitActiveSec=$rep}
Persistent=true
RandomizedDelaySec=60

[Install]
WantedBy=timers.target
EOF
  done <<EOF
watchdog|self-healing watchdog|watchdog|OnBootSec=5min|5min
health|health check with auto-fix (doctor --fix)|autoheal|OnBootSec=15min|$(env_def HEALTH_INTERVAL 1h)
backup|daily backup|backup run|OnCalendar=*-*-* $bt:00|
maintenance|daily maintenance (log pruning, retention, cert renewal)|maintenance|OnCalendar=*-*-* $mt:00|
EOF
  sed -i '/^$/d' "$SYSTEMD_DIR/$UNIT"-*.timer
  # login message with health + reminders (Ubuntu/Debian update-motd)
  if [ -d /etc/update-motd.d ]; then
    printf '#!/bin/sh\n[ -x %s ] && %s --no-color motd 2>/dev/null\nexit 0\n' "$SELF" "$SELF" > /etc/update-motd.d/99-vexor
    chmod 755 /etc/update-motd.d/99-vexor
  fi
}
legacy_cleanup() {             # units, link, completion and motd of the pre-rename name (wazuhctl / wazuh-stack)
  command -v systemctl >/dev/null || return 0
  local t found=0
  for t in watchdog health backup maintenance; do
    [ -f "$SYSTEMD_DIR/wazuh-stack-$t.timer" ] || continue
    systemctl disable --now "wazuh-stack-$t.timer" >/dev/null 2>&1; rm -f "$SYSTEMD_DIR/wazuh-stack-$t".{timer,service}; found=1
  done
  if [ -f "$SYSTEMD_DIR/wazuh-stack.service" ]; then systemctl disable wazuh-stack.service >/dev/null 2>&1; rm -f "$SYSTEMD_DIR/wazuh-stack.service"; found=1; fi
  [ -L /usr/local/bin/wazuhctl ] && rm -f /usr/local/bin/wazuhctl && found=1
  rm -f /etc/bash_completion.d/wazuhctl /etc/update-motd.d/99-wazuhctl
  [ "$found" = 1 ] && { systemctl daemon-reload; ok "removed the old wazuhctl / wazuh-stack units"; }
  return 0
}
daemon_uninstall() {
  command -v systemctl >/dev/null || return 0
  local t
  for t in watchdog health backup maintenance; do systemctl disable --now "$UNIT-$t.timer" >/dev/null 2>&1; rm -f "$SYSTEMD_DIR/$UNIT-$t".{timer,service}; done
  legacy_cleanup
  rm -f /etc/update-motd.d/99-vexor
  systemctl disable "$UNIT.service" >/dev/null 2>&1      # not --now: that would stop the stack
  systemctl disable --now "$UNIT-console.service" >/dev/null 2>&1; rm -f "$SYSTEMD_DIR/$UNIT-console.service"
  rm -f "$SYSTEMD_DIR/$UNIT.service"
  systemctl daemon-reload
  [ "$(readlink -f /usr/local/bin/vexor 2>/dev/null)" = "$SELF" ] && rm -f /usr/local/bin/vexor
  rm -f /etc/bash_completion.d/vexor
  ok "systemd units, PATH link and completion removed (the stack keeps running)"
}
cmd_daemon() {
  local sub="${1:-status}"
  command -v systemctl >/dev/null || die "systemd is required for the daemon"
  case "$sub" in
    install)
      legacy_cleanup
      daemon_units
      ln -sf "$SELF" /usr/local/bin/vexor
      completion_script > /etc/bash_completion.d/vexor
      systemctl daemon-reload
      console_sync || true
      systemctl enable "$UNIT.service" >/dev/null 2>&1
      systemctl is-active -q "$UNIT.service" || systemctl start "$UNIT.service" --no-block
      local t; for t in watchdog health backup maintenance; do systemctl enable --now "$UNIT-$t.timer" >/dev/null 2>&1; done
      ok "vexor is on PATH: /usr/local/bin/vexor  (bash completion installed - open a new shell)"
      ok "$UNIT.service: starts the stack at boot  (systemctl start|stop|status $UNIT)"
      ok "watchdog every 5 min, health check + auto-fix every $(env_def HEALTH_INTERVAL 1h), backup daily $(env_def BACKUP_TIME 01:30), maintenance daily $(env_def MAINT_TIME 02:15)"
      [ -f /etc/update-motd.d/99-vexor ] && ok "SSH login message shows the last health check and due reminders"
      say "Timers: vexor daemon status    Logs: vexor daemon logs" ;;
    uninstall|remove) daemon_uninstall ;;
    status)
      systemctl --no-pager status "$UNIT.service" 2>/dev/null | head -n 5 || warn "$UNIT.service not installed (vexor daemon install)"
      echo; systemctl --no-pager list-timers "$UNIT-*" 2>/dev/null ;;
    logs) journalctl --no-pager -n "${2:-100}" -u "$UNIT*" ;;
    *) die "usage: vexor daemon install|uninstall|status|logs [N]" ;;
  esac
}

