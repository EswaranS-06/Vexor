  tool_on n8n && gen_secret N8N_ENCRYPTION_KEY hex
  if tool_on suricata || tool_on zeek; then
    [ -n "$(env_get SNIFF_INTERFACE)" ] || { env_set SNIFF_INTERFACE "$(sniff_iface)"; say "SNIFF_INTERFACE=$(sniff_iface) (default route) - change it in .env if needed"; }
    ip -o link show "$(sniff_iface)" >/dev/null 2>&1 || die "SNIFF_INTERFACE=$(sniff_iface) does not exist (see: ip -br link)"
  fi
  tool_on suricata && mkdir -p "$TOOLS_DATA/suricata/log"
  if tool_on zeek; then
    mkdir -p "$TOOLS_DATA/zeek/logs" "$TOOLS_DIR/zeek"
    cat > "$TOOLS_DIR/zeek/vexor.zeek" <<'EOF'
# GENERATED by vexor - Zeek in a container without zeekctl: JSON logs, hourly rotation in the log dir.
@load local
redef LogAscii::use_json = T;
redef Log::default_rotation_interval = 1 hr;
EOF
  fi
  write_tool_rules
  TOOLS_MASTER_CHANGED=0 N8N_BLOCKS_CHANGED=0
  soc_wazuh && [ "$(sync_master_localfiles)" = changed ] && TOOLS_MASTER_CHANGED=1
  [ "$(n8n_sync_blocks)" = changed ] && N8N_BLOCKS_CHANGED=1
  sync_profiles; render_override; render_nginx
}
tools_post() {                 # after `docker compose up`: manager reload, users, rules, nginx
  local again=""
  N8N_INSTALLED=""
  soc_wazuh && [ -n "$(n8n_hook)" ] && n8n_install_script
  if [ "${N8N_BLOCKS_CHANGED:-0}" = 1 ]; then again="$(enabled_managers)"
  else again="$N8N_INSTALLED"; [ "${TOOLS_MASTER_CHANGED:-0}" = 1 ] && again="$again wazuh.master"; fi
  again="$(tr ' ' '\n' <<<"$again" | grep -v '^$' | sort -u | while read -r m; do is_running "$m" && echo "$m"; done | tr '\n' ' ')"
  if [ -n "${again// /}" ]; then
    say "recreating $again- they load the sensor log sources / n8n integration (agents reconnect by themselves)"
    dc_restart $again >/dev/null 2>&1
  fi
  if tool_on grafana; then
    { grafana_user_exists && grafana_user_ok && ! grep -q wazuhctl_grafana "$INTERNAL_USERS"; } || grafana_indexer_user add
  elif grafana_user_exists; then
    grafana_indexer_user remove
  fi
  tool_on suricata && suricata_rules_ensure
  nginx_reload >/dev/null 2>&1 || true
  return 0
}
tools_status() {
  hdr "Tools (set <NAME>=true|false in .env, then: vexor tools apply)"
  printf '  %-10s %-8s %-10s %s\n' TOOL ENABLED STATE "ACCESS / NOTE"
  local t on st note
  for t in "${TOOLS[@]}"; do
    on=no; tool_on "$t" && on=yes
    st="$(dc_all ps --format '{{.State}}' "$t" 2>/dev/null | head -1)"; st="${st:--}"
    case "$t" in
      n8n|grafana|portainer) note="https://$(public_host):$(tool_port "$t")" ;;
      *) note="sniffs $(sniff_iface) -> Wazuh (master)" ;;
    esac
    printf '  %-10s %-8s %-10s %s  - %s\n' "$t" "$on" "$st" "$note" "$(tool_desc "$t")"
  done
  tool_on grafana && say "grafana login: admin / GRAFANA_ADMIN_PASSWORD (vexor config get GRAFANA_ADMIN_PASSWORD) - dashboard: Wazuh / Wazuh alerts overview"
  tool_on portainer && say "portainer login: admin / PORTAINER_ADMIN_PASSWORD (only applied on its first start)"
  tool_on n8n && say "n8n: the FIRST person who opens it creates the owner account - open it right after enabling; then: vexor n8n connect && vexor n8n workflow"
  return 0
}
tools_maintenance() {          # daily: rotate sensor logs, prune old ones, refresh Suricata rules
  local keep; keep="$(env_def TOOLS_LOG_RETENTION_DAYS 7)"
  if tool_on suricata && is_running suricata; then
    local d="$TOOLS_DATA/suricata/log" f
    for f in eve.json fast.log stats.log suricata.log; do
      [ -s "$d/$f" ] && mv "$d/$f" "$d/$f.$(date +%Y%m%d)"
    done
    dc kill -s HUP suricata >/dev/null 2>&1          # suricata reopens its log files
    find "$d" -type f -name '*.[0-9]*' -mtime "+$keep" -delete 2>/dev/null
    suricata_update_rules && log "suricata rules updated"
  fi
  if tool_on zeek; then
    find "$TOOLS_DATA/zeek/logs" -type f -name '*.*-*.log' -mtime "+$keep" -delete 2>/dev/null
  fi
  return 0
}
cmd_tools() {
  local sub="${1:-status}"; shift || true
  case "$sub" in
    status|ls) tools_status ;;
    apply)
      take_lock; preflight
      apply_all; tools_status ;;
    enable|disable|on|off)
      local t="${1:-}" v=true; [[ "$sub" == disable || "$sub" == off ]] && v=false
      tool_var "$t" >/dev/null 2>&1 || die "usage: vexor tools $sub <${TOOLS[*]}>"
      env_set "$(tool_var "$t")" "$v"; ok "$(tool_var "$t")=$v"
      cmd_tools apply ;;
    update-rules)
      tool_on suricata || die "SURICATA is not enabled"
      take_lock
      suricata_update_rules -f && sleep 20 && ok "suricata rules updated and reloaded ($(suricata_sig_count) signatures)" ;;
    *) die "usage: vexor tools [status] | apply | enable <tool> | disable <tool> | update-rules   (tools: ${TOOLS[*]})" ;;
  esac
}

# ============================================================== SOC: wazuh | elk | both
# SOC=wazuh : Wazuh (managers, indexers, dashboard) - the default
# SOC=elk   : Elasticsearch + Logstash + Kibana only (sensors and Beats feed Logstash)
# SOC=both  : Wazuh + ELK; Logstash also ships every Wazuh alert into Elasticsearch
# nginx is in front in every mode (Kibana on KIBANA_PORT, web tools on their ports).
soc() { local s; s="$(env_def SOC wazuh)"; s="${s,,}"; [[ "$s" =~ ^(wazuh|elk|both)$ ]] || s=wazuh; echo "$s"; }
soc_wazuh() { [ "$(soc)" != elk ]; }
soc_elk() { [ "$(soc)" != wazuh ]; }
elk_version() { env_def ELK_VERSION 9.5.4; }
es_port() { env_def ES_PORT 59200; }
es_curl() {                    # es_curl <METHOD> <path> [curl args]  - as the elastic superuser, via 127.0.0.1:ES_PORT
  local m="$1" p="$2"; shift 2
  curl -sS --connect-timeout 5 -u "elastic:$(env_get ELASTIC_PASSWORD)" -X "$m" -H 'Content-Type: application/json' \
       "http://127.0.0.1:$(es_port)$p" "$@"
}
es_code() { curl -s -o /dev/null -w '%{http_code}' --max-time 10 -u "elastic:$(env_get ELASTIC_PASSWORD)" "http://127.0.0.1:$(es_port)${1:-/}" 2>/dev/null || true; }
kibana_code() { curl -sk -o /dev/null -w '%{http_code}' --max-time 10 "https://$(local_ip):$(env_def KIBANA_PORT 55601)${1:-/api/status}" 2>/dev/null || true; }
ensure_elk_compose() {         # docker-compose.elk.yml is generated by vexor (listed in COMPOSE_FILE)
  local tmp="${RUN_TMP:-/tmp}/elk.compose.yml"
  cat > "$tmp" <<'EOF'
# ELK stack - GENERATED by vexor, do not edit (versions, ports, heap in .env).
# Started when SOC=elk or SOC=both in .env: vexor soc elk|both   (start / config apply do the same).
x-elk-logging: &elk-logging
  driver: json-file
  options:
    max-size: "${LOG_MAX_SIZE:-50m}"
    max-file: "${LOG_MAX_FILE:-5}"

services:
  elasticsearch:                         # http://127.0.0.1:ES_PORT (host only) - user elastic
    profiles: ["elk"]
    image: docker.elastic.co/elasticsearch/elasticsearch:${ELK_VERSION:-9.5.4}
    hostname: elasticsearch
    restart: always
    logging: *elk-logging
    environment:
      discovery.type: single-node
      cluster.name: vexor-elk
      node.name: elasticsearch
      ES_JAVA_OPTS: "-Xms${ELK_HEAP:-1g} -Xmx${ELK_HEAP:-1g}"
      bootstrap.memory_lock: "true"
      xpack.security.enabled: "true"
      xpack.security.http.ssl.enabled: "false"
      xpack.security.transport.ssl.enabled: "false"
      xpack.license.self_generated.type: basic
      ingest.geoip.downloader.enabled: "false"
      path.repo: /usr/share/elasticsearch/snapshots
      ELASTIC_PASSWORD: ${ELASTIC_PASSWORD:-}
    ulimits:
      memlock: {soft: -1, hard: -1}
      nofile: {soft: 65536, hard: 65536}
    ports:
      - "${ES_BIND:-127.0.0.1}:${ES_PORT:-59200}:9200"
    volumes:
      - elk-es-data:/usr/share/elasticsearch/data
      - ${BACKUP_DIR:-./backups}/es-snapshots:/usr/share/elasticsearch/snapshots

  kibana:                                # https://PUBLIC_HOST:KIBANA_PORT (through nginx) - login elastic
    profiles: ["elk"]
    image: docker.elastic.co/kibana/kibana:${ELK_VERSION:-9.5.4}
    hostname: kibana
    restart: always
    logging: *elk-logging
    environment:
      ELASTICSEARCH_HOSTS: '["http://elasticsearch:9200"]'
      ELASTICSEARCH_USERNAME: kibana_system
      ELASTICSEARCH_PASSWORD: ${KIBANA_SYSTEM_PASSWORD:-}
      SERVER_PUBLICBASEURL: https://${PUBLIC_HOST:-localhost}:${KIBANA_PORT:-55601}
      XPACK_ENCRYPTEDSAVEDOBJECTS_ENCRYPTIONKEY: ${KIBANA_ENCRYPTION_KEY:-}
      XPACK_SECURITY_ENCRYPTIONKEY: ${KIBANA_ENCRYPTION_KEY:-}
      XPACK_REPORTING_ENCRYPTIONKEY: ${KIBANA_ENCRYPTION_KEY:-}
      TELEMETRY_OPTIN: "false"
    volumes:
      - elk-kibana-data:/usr/share/kibana/data

  logstash:                              # Beats/Elastic Agent: PUBLIC_HOST:LOGSTASH_BEATS_PORT; reads Wazuh alerts + sensors
    profiles: ["elk"]
    image: docker.elastic.co/logstash/logstash:${ELK_VERSION:-9.5.4}
    hostname: logstash
    restart: always
    logging: *elk-logging
    user: "0:0"                          # reads the managers' alerts.json (owned by the wazuh user) read-only
    environment:
      LS_JAVA_OPTS: "-Xms${LOGSTASH_HEAP:-512m} -Xmx${LOGSTASH_HEAP:-512m}"
      VEXOR_ES_USER: vexor_logstash
      VEXOR_ES_PASSWORD: ${LOGSTASH_ES_PASSWORD:-}
      VEXOR_N8N_URL: ${N8N_HOOK_URL:-}
      VEXOR_N8N_TOKEN: ${N8N_HOOK_TOKEN:-}
    ports:
      - "${BIND_IP:-0.0.0.0}:${LOGSTASH_BEATS_PORT:-55044}:5044"
    volumes:
      - ./config/elk/logstash/logstash.yml:/usr/share/logstash/config/logstash.yml:ro
      - ./config/elk/logstash/pipeline:/usr/share/logstash/pipeline:ro
      - ./config/elk/logstash/certs:/usr/share/logstash/certs:ro
      - elk-logstash-data:/usr/share/logstash/data
      - master-wazuh-logs:/wazuh-logs/master:ro
      - worker-wazuh-logs:/wazuh-logs/worker:ro
      - worker2-wazuh-logs:/wazuh-logs/worker2:ro
      - worker3-wazuh-logs:/wazuh-logs/worker3:ro
      - ./tools-data:/vexor-sensors:ro

volumes:
  elk-es-data:
  elk-kibana-data:
  elk-logstash-data:
EOF
  cmp -s "$tmp" "$ELK_COMPOSE" || cp "$tmp" "$ELK_COMPOSE"
  rm -f "$tmp"
}
# ============================================================== Logstash Beats input over TLS
# LOGSTASH_BEATS_TLS=true: the Beats input on LOGSTASH_BEATS_PORT only accepts TLS. Server certificate signed by the
# stack's internal root CA (config/wazuh_indexer_ssl_certs/root-ca.pem); senders trust that CA (vexor elk beats-ca).
LS_CERT_DIR="$ROOT/config/elk/logstash/certs"
logstash_tls_on() { [[ "$(env_def LOGSTASH_BEATS_TLS false)" =~ ^(true|yes|on|1)$ ]]; }
logstash_sans() {
  local s="DNS:logstash,DNS:localhost,IP:127.0.0.1" h ip; h="$(public_host)"
  if [[ "$h" =~ ^[0-9]+(\.[0-9]+){3}$ ]]; then s+=",IP:$h"; else s+=",DNS:$h"; fi
  for ip in $(host_ips); do [[ ",$s," == *",IP:$ip,"* ]] || s+=",IP:$ip"; done
  echo "$s"
}
logstash_certs() {             # issue/renew the Beats server certificate (only when TLS is on)
  mkdir -p "$LS_CERT_DIR"
  logstash_tls_on || return 0
  local d="$LS_CERT_DIR" ca="$INT_CERT_DIR/root-ca.pem" cakey="$INT_CERT_DIR/root-ca.key" sans
  [ -f "$ca" ] && [ -f "$cakey" ] || { warn "internal CA missing - Beats TLS needs: vexor install"; return 1; }
  sans="$(logstash_sans)"
  if [ -s "$d/logstash.crt" ] && [ -s "$d/logstash.key" ] && [ "$(cat "$d/sans" 2>/dev/null)" = "$sans" ] \
     && [ "$(cert_days_left "$d/logstash.crt")" -gt 30 ] && cmp -s "$ca" "$d/ca.crt"; then
    return 0
  fi
  openssl req -new -newkey rsa:2048 -nodes -keyout "$RUN_TMP/ls.key" -subj "/CN=logstash/O=Vexor" -out "$RUN_TMP/ls.csr" 2>/dev/null \
    && printf 'subjectAltName=%s\nextendedKeyUsage=serverAuth\nkeyUsage=digitalSignature,keyEncipherment\n' "$sans" > "$RUN_TMP/ls.ext" \
    && openssl x509 -req -in "$RUN_TMP/ls.csr" -CA "$ca" -CAkey "$cakey" -CAcreateserial -CAserial "$RUN_TMP/ls.srl" \
         -days 825 -sha256 -extfile "$RUN_TMP/ls.ext" -out "$d/logstash.crt" 2>/dev/null \
    && openssl pkcs8 -topk8 -nocrypt -in "$RUN_TMP/ls.key" -out "$d/logstash.key" \
    || { bad "could not issue the Logstash Beats certificate"; return 1; }
  cp "$ca" "$d/ca.crt"; echo "$sans" > "$d/sans"
  chmod 644 "$d/logstash.crt" "$d/ca.crt"; chmod 600 "$d/logstash.key"
  ok "Logstash Beats certificate issued for ${sans//,/ }"
}
write_logstash_config() {      # pipeline follows SOC + sensors; Logstash reloads it by itself
  mkdir -p "$ELK_DIR/logstash/pipeline" "$TOOLS_DATA"
  cat > "$ELK_DIR/logstash/logstash.yml.tmp" <<'EOF'
# GENERATED by vexor
config.reload.automatic: true
config.reload.interval: 30s
allow_superuser: true
EOF
  local wz=0 su=0 ze=0
  [ "$(soc)" = both ] && wz=1
  tool_on suricata && su=1
  tool_on zeek && ze=1
  local nf=0; [ "$(soc)" = elk ] && [ -n "$(n8n_hook)" ] && nf=1
  python3 -I - "$ELK_DIR/logstash/pipeline/vexor.conf.tmp" "$wz" "$su" "$ze" "$(env_def ZEEK_WAZUH_LOGS notice,weird,dns,http,ssl,ssh)" "$nf" "$(n8n_level)" "$(logstash_tls_on && echo 1 || echo 0)" <<'PY'
import sys
out, wz, su, ze, zl = sys.argv[1], sys.argv[2] == "1", sys.argv[3] == "1", sys.argv[4] == "1", sys.argv[5]
n8n, lvl, tls = sys.argv[6] == "1", int(sys.argv[7]), sys.argv[8] == "1"
zfiles = ", ".join(f'"/vexor-sensors/zeek/logs/{n.strip()}.log"' for n in zl.split(",") if n.strip())
beats_tls = (' ssl_enabled => true ssl_certificate => "/usr/share/logstash/certs/logstash.crt"'
             ' ssl_key => "/usr/share/logstash/certs/logstash.key" ssl_client_authentication => "none"') if tls else ""
i = ["input {", '  beats { port => 5044 tags => ["beats"]' + beats_tls + ' }']
if wz:
    i.append('  file { path => "/wazuh-logs/*/alerts/alerts.json" codec => "json" mode => "tail" start_position => "end"'
             ' sincedb_path => "/usr/share/logstash/data/sincedb-wazuh" tags => ["wazuh"] }')
if su:
    i.append('  file { path => "/vexor-sensors/suricata/log/eve.json" codec => "json" mode => "tail" start_position => "end"'
             ' sincedb_path => "/usr/share/logstash/data/sincedb-suricata" tags => ["suricata"] }')
if ze and zfiles:
    i.append(f'  file {{ path => [{zfiles}] codec => "json" mode => "tail" start_position => "end"'
             ' sincedb_path => "/usr/share/logstash/data/sincedb-zeek" tags => ["zeek"] }')
i.append("}")
f = ["filter {",
     '  if "wazuh" in [tags] or "suricata" in [tags] {',
     '    date { match => ["timestamp", "ISO8601", "yyyy-MM-dd\'T\'HH:mm:ss.SSSZ"] target => "@timestamp" tag_on_failure => ["_vexor_date_failure"] }',
     "  }",
     '  if "zeek" in [tags] {',
     '    date { match => ["ts", "UNIX"] target => "@timestamp" }',
     '    grok { match => { "[log][file][path]" => "/(?<[zeek][log]>[a-z_]+)\\.log$" } tag_on_failure => [] }',
     "  }"]
if n8n:                       # SOC=elk: no Wazuh in between - Logstash hands alerts to n8n itself
    sev = [str(k) for k, v in {1: 12, 2: 7, 3: 4}.items() if v >= lvl]
    if su and sev:
        f += ['  if "suricata" in [tags] and [event_type] == "alert" and [alert][severity] in [%s] {' % ", ".join(sev),
              '    mutate { add_tag => ["n8n"] }', "  }"]
    if ze and lvl <= 6:
        f += ['  if "zeek" in [tags] and [zeek][log] == "notice" { mutate { add_tag => ["n8n"] } }']
f.append("}")
es = '    elasticsearch { hosts => ["http://elasticsearch:9200"] user => "${VEXOR_ES_USER}" password => "${VEXOR_ES_PASSWORD}" index => "%s-%%{+YYYY.MM.dd}" }'
o = ["output {",
     '  if "wazuh" in [tags] {', es % "vexor-wazuh-alerts",
     '  } else if "suricata" in [tags] {', es % "vexor-suricata",
     '  } else if "zeek" in [tags] {', es % "vexor-zeek",
     "  } else {", es % "vexor-beats",
     "  }"]
if n8n:
    o += ['  if "n8n" in [tags] {',
          '    http { url => "${VEXOR_N8N_URL}" http_method => "post" format => "json"'
          ' headers => { "X-Vexor-Token" => "${VEXOR_N8N_TOKEN}" "X-Vexor-Source" => "logstash" } }',
          "  }"]
o.append("}")
open(out, "w").write("# GENERATED by vexor - follows SOC and SURICATA/ZEEK in .env\n" + "\n".join(i + [""] + f + [""] + o) + "\n")
PY
  local f; for f in "$ELK_DIR/logstash/logstash.yml" "$ELK_DIR/logstash/pipeline/vexor.conf"; do
    if cmp -s "$f.tmp" "$f"; then rm -f "$f.tmp"; else mv "$f.tmp" "$f"; fi
    chmod 644 "$f"
  done
}
elk_prepare() {                # before `docker compose up`
  ensure_elk_compose
  soc_elk || return 0
  gen_secret ELASTIC_PASSWORD; gen_secret KIBANA_SYSTEM_PASSWORD; gen_secret LOGSTASH_ES_PASSWORD
  gen_secret KIBANA_ENCRYPTION_KEY hex
  local p; for p in KIBANA_PORT LOGSTASH_BEATS_PORT ES_PORT; do
    [[ "$(env_def "$p" x)" =~ ^5[0-9]{4}$ ]] || die "$p=$(env_get "$p") - ELK ports must be in 50000-59999"
  done
  es_snapshot_dir >/dev/null
  logstash_certs || warn "Beats input stays without TLS until the certificate can be issued"
  write_logstash_config
}
elk_post() {                   # after `docker compose up`: users, roles, retention, data views
  soc_elk || return 0
  local i c=""
  wait_ready_run 300 0 elasticsearch >/dev/null 2>&1; c="$(es_code /_cluster/health)"
  if [ "$c" = 401 ]; then
    bad "Elasticsearch rejects ELASTIC_PASSWORD (it is set only on the FIRST start of the data volume)"
    hint "put the old value back in .env, or reset it: vexor elk reset-password"; return 1
  fi
  [ "$c" = 200 ] || { warn "Elasticsearch not ready yet (HTTP ${c:-000}) - vexor doctor --fix finishes the setup"; return 1; }
  es_curl POST /_security/user/kibana_system/_password -d "{\"password\":\"$(env_get KIBANA_SYSTEM_PASSWORD)\"}" | has -E '^\{\}$' \
    && ok "kibana_system password set" || warn "could not set the kibana_system password"
  es_curl PUT /_security/role/vexor_logstash -d '{"cluster":["monitor","manage_index_templates","manage_ilm"],
    "indices":[{"names":["vexor-*"],"privileges":["create_index","create","index","write","auto_configure","view_index_metadata"]}]}' >/dev/null
  es_curl PUT /_security/user/vexor_logstash -d "{\"password\":\"$(env_get LOGSTASH_ES_PASSWORD)\",\"roles\":[\"vexor_logstash\"],\"full_name\":\"Vexor Logstash writer\"}" \
    | has '"created"' && ok "Elasticsearch user vexor_logstash (write vexor-* only)" || warn "could not create the vexor_logstash user"
  elk_retention_apply
  wait_ready_run 300 0 kibana >/dev/null 2>&1; c="$(kibana_code)"
  if [ "$c" = 200 ]; then elk_data_views; else warn "Kibana not ready yet (HTTP ${c:-000}) - first start takes 2-3 min; vexor doctor --fix adds the data views"; fi
  return 0
}
elk_retention_apply() {        # ILM delete after ELK_RETENTION_DAYS + template: 0 replicas (single node), no mapping conflicts on data.*
  local d; d="$(env_def ELK_RETENTION_DAYS 30)"
  es_curl PUT /_ilm/policy/vexor-retention -d "{\"policy\":{\"phases\":{\"hot\":{\"actions\":{}},\"delete\":{\"min_age\":\"${d}d\",\"actions\":{\"delete\":{}}}}}}" >/dev/null
  es_curl PUT /_index_template/vexor -d '{"index_patterns":["vexor-*"],"priority":200,
    "template":{"settings":{"number_of_replicas":0,"index.lifecycle.name":"vexor-retention","index.mapping.total_fields.limit":5000},
      "mappings":{"dynamic_templates":[{"strings_as_keyword":{"match_mapping_type":"string","mapping":{"type":"keyword","ignore_above":1024}}}],
        "properties":{"@timestamp":{"type":"date"},"full_log":{"type":"text"},"data":{"type":"flattened"},"syscheck":{"type":"flattened"},
          "rule":{"properties":{"level":{"type":"integer"},"id":{"type":"keyword"}}}}}}}' | has '"acknowledged":true' \
    && ok "Elasticsearch retention: vexor-* indices deleted after $d days (ILM), 0 replicas"
  es_curl PUT '/vexor-*/_settings?allow_no_indices=true' -d '{"index":{"number_of_replicas":0}}' >/dev/null 2>&1
  return 0
}
elk_data_views() {             # Kibana data views for every vexor index family
  local id title name base; base="https://$(local_ip):$(env_def KIBANA_PORT 55601)"
  for x in "vexor-wazuh-alerts|vexor-wazuh-alerts-*|Vexor - Wazuh alerts" "vexor-suricata|vexor-suricata-*|Vexor - Suricata" \
           "vexor-zeek|vexor-zeek-*|Vexor - Zeek" "vexor-beats|vexor-beats-*|Vexor - Beats / Elastic Agent"; do
    IFS='|' read -r id title name <<<"$x"
    [ "$(curl -sk -o /dev/null -w '%{http_code}' -u "elastic:$(env_get ELASTIC_PASSWORD)" "$base/api/data_views/data_view/$id")" = 200 ] && continue
    curl -sk -o /dev/null -u "elastic:$(env_get ELASTIC_PASSWORD)" -H 'kbn-xsrf: true' -H 'Content-Type: application/json' \
      -X POST "$base/api/data_views/data_view" \
      -d "{\"data_view\":{\"id\":\"$id\",\"title\":\"$title\",\"name\":\"$name\",\"timeFieldName\":\"@timestamp\"}}"
  done
  ok "Kibana data views: Vexor - Wazuh alerts / Suricata / Zeek / Beats"
}
elk_status_lines() {           # for vexor status
  local c; c="$(es_code /_cluster/health)"
  if [ "$c" = 200 ]; then
    local h; h="$(es_curl GET /_cluster/health | pj 'print("%s  (%s shards, %s unassigned)" % (d["status"], d["active_shards"], d["unassigned_shards"]))' 2>/dev/null)"
    case "$h" in green*) ok "Elasticsearch: $h" ;; yellow*) warn "Elasticsearch: $h" ;; *) bad "Elasticsearch: $h" ;; esac
  else bad "Elasticsearch: HTTP ${c:-000}"; fi
  c="$(kibana_code)"
  if [ "$c" = 200 ]; then ok "Kibana: https://$(public_host):$(env_def KIBANA_PORT 55601)  (login elastic)"
  else warn "Kibana: HTTP ${c:-000} (first start takes 2-3 min)"; fi
  local n; n="$(es_curl GET '/vexor-*/_count?allow_no_indices=true' -d '{"query":{"range":{"@timestamp":{"gte":"now-1h"}}}}' 2>/dev/null | pj 'print(d.get("count",0))' 2>/dev/null)"
  [ -n "$n" ] && say "Events into Elasticsearch in the last hour: $n"
  return 0
}
elk_doctor() {                 # ELK checks + predictable repairs
  hdr "ELK (SOC=$(soc), Elastic $(elk_version))"
  local c st
  c="$(es_code /_cluster/health)"
  case "$c" in
    200) d_pass "Elasticsearch reachable, elastic login OK" ;;
    401) d_fail "Elasticsearch rejects ELASTIC_PASSWORD (only applied on the first start of the data volume)" "restore the old value in .env, or: vexor elk reset-password" ;;
    000|"") if ! d_starting elasticsearch; then
              d_fail "Elasticsearch not answering on 127.0.0.1:$(es_port)" "vexor logs elasticsearch   ('max virtual memory areas' = vm.max_map_count, 'OutOfMemoryError' = lower ELK_HEAP)"
              [ "$(svc_uptime_s elasticsearch)" -ge 240 ] && d_fix "restart elasticsearch" && dc restart elasticsearch >/dev/null 2>&1
            fi ;;
    *) d_fail "Elasticsearch: HTTP $c" "vexor logs elasticsearch" ;;
  esac
  if [ "$c" = 200 ]; then
    st="$(es_curl GET /_cluster/health | pj 'print(d["status"])' 2>/dev/null)"
    case "$st" in
      green) d_pass "Elasticsearch cluster green" ;;
      yellow) d_warn "Elasticsearch yellow - replica copies cannot be placed on a single node" "vexor doctor --fix (sets replicas 0)"
              d_fix "set replicas 0 on all indices" && es_curl PUT '/_all/_settings?expand_wildcards=open' -d '{"index":{"number_of_replicas":0}}' >/dev/null ;;
      *) d_fail "Elasticsearch cluster $st" "vexor elk explain" ;;
    esac
    local ro; ro="$(es_curl GET '/_all/_settings/index.blocks.read_only_allow_delete' | pj 'print(sum(1 for v in d.values() if v.get("settings",{}).get("index",{}).get("blocks",{}).get("read_only_allow_delete") == "true"))' 2>/dev/null)"
    if [ "${ro:-0}" -gt 0 ]; then
      d_fail "$ro Elasticsearch indices are read-only (disk flood stage)" "free disk or lower ELK_RETENTION_DAYS"
      d_fix "clear read-only blocks" && es_curl PUT /_all/_settings -d '{"index.blocks.read_only_allow_delete": null}' >/dev/null
    fi
    if [ "$(es_code /_ilm/policy/vexor-retention)" = 200 ] && [ "$(es_code /_index_template/vexor)" = 200 ]; then d_pass "retention (ILM) + index template present"
    else d_warn "ILM policy / index template missing" "vexor doctor --fix"; d_fix "apply ELK retention + template" && elk_retention_apply >/dev/null; fi
    if [ "$(es_code "/_snapshot/$ES_SNAP_REPO")" = 200 ]; then d_pass "Elasticsearch snapshot repository registered (vexor backup includes ELK)"
    else d_warn "Elasticsearch snapshot repository not registered yet" "vexor doctor --fix   (or the next vexor backup)"
         d_fix "register the Elasticsearch snapshot repository" && es_snapshot_register >/dev/null; fi
    if [ "$(curl -s -o /dev/null -w '%{http_code}' -u "vexor_logstash:$(env_get LOGSTASH_ES_PASSWORD)" "http://127.0.0.1:$(es_port)/_security/_authenticate")" = 200 ]; then
      d_pass "Logstash user vexor_logstash can log in"
    else d_fail "Logstash user vexor_logstash cannot log in (events are not stored)" "vexor doctor --fix"; d_fix "re-create users/roles" && elk_post >/dev/null 2>&1; fi
  fi
  c="$(kibana_code)"
  case "$c" in
    200) d_pass "Kibana https://$(public_host):$(env_def KIBANA_PORT 55601) available" ;;
    503|502) if d_starting kibana; then :
             else d_fail "Kibana not available (HTTP $c)" "vexor logs kibana   ('unable to authenticate user [kibana_system]' = password mismatch)"
                  d_fix "reset kibana_system password + restart kibana" && { es_curl POST /_security/user/kibana_system/_password -d "{\"password\":\"$(env_get KIBANA_SYSTEM_PASSWORD)\"}" >/dev/null; dc restart kibana >/dev/null 2>&1; }; fi ;;
    *) d_fail "nothing answers on Kibana port $(env_def KIBANA_PORT 55601) (HTTP ${c:-000})" "vexor doctor --fix"
       d_fix "render nginx + recreate it" && { render_override; render_nginx; dc up -d --no-deps --force-recreate nginx >/dev/null 2>&1; } ;;
  esac
  [ "$c" = 200 ] && [ "$(curl -sk -o /dev/null -w '%{http_code}' -u "elastic:$(env_get ELASTIC_PASSWORD)" "https://$(local_ip):$(env_def KIBANA_PORT 55601)/api/data_views/data_view/vexor-wazuh-alerts")" != 200 ] \
    && { d_warn "Kibana data views missing" "vexor doctor --fix"; d_fix "create the Kibana data views" && elk_data_views >/dev/null; }
  if is_running logstash; then
    local ps; ps="$(dc exec -T logstash curl -s localhost:9600/_node/stats/pipelines 2>/dev/null | pj '
p = d.get("pipelines", {}).get("main")
print("none" if p is None else "%s in / %s out" % (p["events"]["in"], p["events"]["out"]))' 2>/dev/null)"
    if [ -n "$ps" ] && [ "$ps" != none ]; then d_pass "Logstash pipeline running ($ps events)"
    else d_warn "Logstash pipeline not running yet" "vexor logs logstash   (pipeline errors are logged at start)"; fi
    [ "$(soc)" = both ] && ! dc exec -T logstash test -r /wazuh-logs/master/alerts/alerts.json 2>/dev/null \
      && d_warn "Logstash cannot read the master's alerts.json" "vexor logs logstash"
  fi
  if logstash_tls_on; then
    local ld; ld="$(cert_days_left "$LS_CERT_DIR/logstash.crt" 2>/dev/null)"
    if [ -n "$ld" ] && [ "$ld" -gt 30 ] && [ "$(cat "$LS_CERT_DIR/sans" 2>/dev/null)" != "$(logstash_sans)" ]; then
      d_warn "Beats TLS certificate does not match this machine's addresses ($(public_host)) - the IP changed?" "vexor doctor --fix"
      d_fix "re-issue the Logstash certificate" && { logstash_certs && write_logstash_config && dc restart logstash >/dev/null 2>&1; }
    elif [ -n "$ld" ] && [ "$ld" -gt 30 ]; then d_pass "Beats input uses TLS (certificate valid $ld days)"
    else d_warn "Beats TLS certificate missing or expiring (${ld:-none})" "vexor doctor --fix"
         d_fix "re-issue the Logstash certificate" && { logstash_certs && write_logstash_config; }; fi
  else
    d_warn "the Beats input on port $(env_def LOGSTASH_BEATS_PORT 55044) accepts plain TCP" "LOGSTASH_BEATS_TLS=true, vexor config apply, then: vexor elk beats-config"
  fi
  return 0
}
pull_missing_images() {        # predictable issue: registry TLS/network hiccups - retry each missing image
  local img t fail=0
  for img in $(dc config --images 2>/dev/null | sort -u); do
    docker image inspect "$img" >/dev/null 2>&1 && continue
    for t in 1 2 3 4; do
      docker pull -q "$img" >/dev/null 2>&1 && { say "pulled $img"; break; }
      [ "$t" = 4 ] && { bad "could not pull $img (network/registry) - retry later: vexor start"; fail=1; break; }
      say "pull of $img failed - retry $t/3 in $((t * 10))s"; sleep $((t * 10))
    done
  done
  return "$fail"
}
cmd_soc() {
  local target="${1:-status}"; shift || true
  case "$target" in
    status)
      hdr "SOC=$(soc)"
      soc_wazuh && say "Wazuh   : $(layout_desc)"
      soc_elk && say "ELK     : Elastic $(elk_version) - Kibana https://$(public_host):$(env_def KIBANA_PORT 55601), Beats -> $(public_host):$(env_def LOGSTASH_BEATS_PORT 55044)"
      [ "$(soc)" = both ] && say "Wazuh alerts are copied into Elasticsearch (vexor-wazuh-alerts-*)"
      hint "switch: vexor soc wazuh | elk | both   (data of a stack that is switched off stays in its volumes)" ;;
    wazuh|elk|both)
      local cur; cur="$(soc)"
      [ "$cur" = "$target" ] && { ok "already SOC=$target"; return 0; }
      [ "$target" = elk ] && warn "SOC=elk stops Wazuh: agents cannot report until you switch back (their keys and all alerts are kept)"
      [ "$cur" != wazuh ] && [ "$target" = wazuh ] && say "ELK is stopped; its data stays in the elk-* volumes"
      confirm "Switch SOC $cur -> $target?" || die "Aborted"
      take_lock; preflight
      env_set SOC "$target"; echo "$(ts) soc $target (from $cur)" >> "$HISTORY_FILE"
      apply_all
      ok "SOC=$target" ;;
    *) die "usage: vexor soc [status] | wazuh | elk | both" ;;
  esac
}
apply_all() {                  # the one reconcile path: render everything, pull, up, post-steps
  tools_prepare; elk_prepare
  pull_missing_images || warn "some images are missing - their services will not start"
  prune_disabled_containers
  dc up -d || die "docker compose up failed - see the error above, then: vexor doctor"
  soc_wazuh && wait_indexer 300 && post_start      # users/roles below need a running indexer
  tools_post
  elk_post
  soc_wazuh && wait_dashboard 240
  nginx_reload >/dev/null 2>&1 || true
  console_sync || true
  record_applied_env
  return 0
}
cmd_elk() {
  case "${1:-status}" in
    status) soc_elk || die "ELK is off (SOC=$(soc)) - enable it: vexor soc both|elk"; hdr "ELK (Elastic $(elk_version))"; elk_status_lines
            say "Beats / Elastic Agent -> $(public_host):$(env_def LOGSTASH_BEATS_PORT 55044)   (vexor elk beats-config)" ;;
    explain) es_curl GET /_cluster/allocation/explain?pretty ;;
    reset-password)
      soc_elk || die "ELK is off"
      take_lock
      local np; np="$(gen_pw)"
      say "resetting the elastic password inside the container ..."
      if dc exec -T elasticsearch bin/elasticsearch-reset-password -u elastic -b -s --url http://localhost:9200 >"$RUN_TMP/espw" 2>/dev/null; then
        local gen; gen="$(tr -d '\r\n' < "$RUN_TMP/espw")"
        env_set ELASTIC_PASSWORD "$gen"; chmod 600 "$ENV_FILE"
        es_curl POST /_security/user/elastic/_password -d "{\"password\":\"$np\"}" >/dev/null && env_set ELASTIC_PASSWORD "$np"
        ok "elastic password reset and stored in .env"; elk_post
      else bad "reset failed - vexor logs elasticsearch"; fi ;;
    indices) es_curl GET '/_cat/indices/vexor-*?v&s=index&h=health,index,docs.count,store.size&expand_wildcards=open' ;;
    search) shift; soc_elk || die "ELK is off"; elk_search "$@" ;;
    data-views) soc_elk || die "ELK is off"; elk_data_views ;;
    retention) soc_elk || die "ELK is off"; elk_retention_apply ;;
    beats-config|filebeat) soc_elk || die "ELK is off"; elk_beats_config ;;
    beats-ca) logstash_tls_on || die "LOGSTASH_BEATS_TLS is off"; cat "$LS_CERT_DIR/ca.crt" 2>/dev/null || die "no certificate yet - vexor config apply" ;;
    es) shift; soc_elk || die "ELK is off"; local m="${1:?usage: vexor elk es <METHOD> <path> [json]}" pth="${2:?path}"; shift 2
        if [ $# -gt 0 ]; then es_curl "$m" "$pth" -d "$1"; else es_curl "$m" "$pth"; fi; echo ;;
    logs) shift; cmd_logs "${@:-elasticsearch}" ;;
    *) die "usage: vexor elk [status] | indices | search [query] [-n N] [--index P] | data-views | retention
                | beats-config | beats-ca | es <METHOD> <path> [json] | explain | reset-password | logs [svc]" ;;
  esac
}

