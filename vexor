# ============================================================== Wazuh (SIEM / XDR)
wazuh_alerts() {               # [-n N] [--level N] [--grep TEXT]: newest alerts of every manager
  local n=20 lvl=0 grep_="" m
  while [ $# -gt 0 ]; do case "$1" in -n) n="${2:?}"; shift ;; --level) lvl="${2:?}"; shift ;; --grep) grep_="${2:?}"; shift ;; esac; shift; done
  soc_wazuh || die "Wazuh is off (SOC=$(soc))"
  for m in $(enabled_managers); do
    is_running "$m" || continue
    dc exec -T "$m" tail -n 3000 /var/ossec/logs/alerts/alerts.json 2>/dev/null
  done | python3 -I -c '
import datetime, json, sys
n, lvl, needle = int(sys.argv[1]), int(sys.argv[2]), sys.argv[3].lower()
rows = []
for line in sys.stdin:
    if needle and needle not in line.lower():
        continue
    try:
        a = json.loads(line)
    except ValueError:
        continue
    r = a.get("rule", {})
    if int(r.get("level", 0)) < lvl:
        continue
    try:
        t = datetime.datetime.strptime(a["timestamp"], "%Y-%m-%dT%H:%M:%S.%f%z").astimezone()
    except (KeyError, ValueError):
        continue
    rows.append((t, "%s  lvl %-2s  rule %-6s %-16s %s" % (t.strftime("%Y-%m-%d %H:%M:%S"), r.get("level"), r.get("id"),
                 (a.get("agent") or {}).get("name", "-")[:16], r.get("description", ""))))
rows.sort()
print("\n".join(r for _, r in rows[-n:]) if rows else "  no matching alerts")' "$n" "$lvl" "$grep_"
}
cmd_wazuh() {
  local sub="${1:-status}"; shift || true
  case "$sub" in
    status) soc_wazuh || die "Wazuh is off (SOC=$(soc)) - vexor soc wazuh|both"; cmd_health ;;
    alerts) wazuh_alerts "$@" ;;
    logtest) is_running wazuh.master || die "wazuh.master is not running"
             say "paste a log line, see which decoder/rule matches (Ctrl+C to quit)"; dc exec wazuh.master /var/ossec/bin/wazuh-logtest ;;
    rules) is_running wazuh.master || die "wazuh.master is not running"
           dc exec -T wazuh.master sh -c 'ls -l /var/ossec/etc/rules/; echo; grep -c "<rule " /var/ossec/etc/rules/*.xml' ;;
    agents) cmd_agents "$@" ;;
    cluster) cmd_cluster ;;
    *) die "usage: vexor wazuh [status] | alerts [-n N] [--level N] [--grep TEXT] | logtest | rules | agents ... | cluster" ;;
  esac
}

# ============================================================== ELK extras
elk_search() {                 # elk search [query] [-n N] [--index P]
  local q="*" n=20 idx="vexor-*"
  [ $# -gt 0 ] && [[ "$1" != -* ]] && { q="$1"; shift; }
  while [ $# -gt 0 ]; do case "$1" in -n) n="${2:?}"; shift ;; --index) idx="${2:?}"; shift ;; esac; shift; done
  es_curl GET "/$idx/_search?allow_no_indices=true" -d "$(python3 -I -c 'import json,sys; print(json.dumps({"size": int(sys.argv[2]), "sort": [{"@timestamp": {"order": "desc", "unmapped_type": "date"}}], "query": {"query_string": {"query": sys.argv[1]}}}))' "$q" "$n")" \
    | python3 -I -c '
import json, sys
d = json.load(sys.stdin)
if "error" in d:
    print("  error:", d["error"].get("reason", d["error"])); sys.exit(1)
hits = d["hits"]["hits"]
print("  %s matches (newest %d shown)" % (d["hits"]["total"]["value"], len(hits)))
for h in reversed(hits):
    s = h["_source"]
    if "rule" in s: txt = "lvl %s %s" % (s["rule"].get("level"), s["rule"].get("description"))
    elif "alert" in s: txt = "sev %s %s" % (s["alert"].get("severity"), s["alert"].get("signature"))
    elif s.get("event_type"): txt = "%s %s -> %s" % (s["event_type"], s.get("src_ip"), s.get("dest_ip"))
    else: txt = json.dumps({k: v for k, v in s.items() if not k.startswith(("@", "event", "log", "host", "tags"))})[:160]
    print("  %s  %-24s %s" % (s.get("@timestamp", "")[:19].replace("T", " "), h["_index"][:24], txt))'
}
