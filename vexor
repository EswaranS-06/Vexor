#!/usr/bin/env bash
# =============================================================================
#  vexor - CLI for Vexor: a Docker SOC stack (Wazuh, ELK or both) with optional tools
#
#  Lives next to docker-compose.yml and .env (.env holds every setting).
#      ./vexor help              every command
#      ./vexor install           first-time setup (safe to re-run)
#      ./vexor node-type single|multi   switch the layout; agents, alerts and settings are kept
#      ./vexor daemon install    `vexor` on PATH + systemd service/timers
# =============================================================================
