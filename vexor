      if [ "$json" = 1 ]; then printf '%s\n' "$t"; return 0; fi
      pj '
for s in d["settings"]:
    v = s["value"]
    v = "; ".join(v) if isinstance(v, list) else (v if v not in (None, "") else "-")
    print("  %-21s %-7s %s" % (s["key"], s["scope"], v))
    print("  %-21s %-7s   %s" % ("", "", s["help"] + (" (" + "|".join(s["choices"]) + ")" if s["choices"] else "")))' <<<"$t" ;;
