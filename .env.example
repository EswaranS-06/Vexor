# =============================================================================
#  Vexor - every setting lives here. Copy to .env (vexor install does it for you).
#  Values left as CHANGE_ME are generated by `vexor install` / when a feature is enabled.
#  Apply changes with: vexor config apply   (see "Change management" in README.md)
# =============================================================================
# Docker project name (containers vexor-*, volumes vexor_*). Installs before 2.0 use "wazuh" - rename with: vexor migrate
COMPOSE_PROJECT_NAME=vexor

# ---- What runs ----------------------------------------------------------------
# wazuh | elk | both   (switch: vexor soc <value>)
SOC=wazuh
# single (1 manager + 1 indexer) | multi (master + WORKER_COUNT workers + 3 indexers)
NODE_TYPE=single
# workers used in node type multi (1-3)
WORKER_COUNT=1
# 3 or 1 - managed by `vexor node-type` / `vexor indexers` (moves the data safely)
INDEXER_COUNT=1

# ---- Versions -----------------------------------------------------------------
WAZUH_VERSION=4.14.8
NGINX_IMAGE=nginx:stable
ELK_VERSION=9.5.4

# ---- Addresses / ports (Wazuh) ------------------------------------------------
# IP or DNS name clients use for this server (empty = detected each time vexor runs, so a moved
# machine or a new DHCP address needs no edit; after a change: vexor cert create)
PUBLIC_HOST=
# address the published ports listen on; 0.0.0.0 = all interfaces
BIND_IP=0.0.0.0
# dashboard over HTTPS through nginx
PROXY_PORT=8080
# agent events (nginx balances them over the managers)
AGENT_PORT=1514
# agent enrollment (master)
ENROLL_PORT=1515
SYSLOG_PORT=514
API_PORT=55000
# indexer REST API, bound to this host only
INDEXER_BIND=127.0.0.1
INDEXER_HOST_PORT=9200
# proxy routes (vexor proxy): HTTPS / HTTP ports for named hosts like soc.example.com;
# published on BIND_IP only while at least one route exists (HTTP serves ACME challenges + redirects)
ROUTES_HTTPS_PORT=443
ROUTES_HTTP_PORT=80

# ---- Ports (ELK + tools) - 50000-59999, HTTPS through nginx ------------------
KIBANA_PORT=55601
ES_PORT=59200
ES_BIND=127.0.0.1
LOGSTASH_BEATS_PORT=55044
# TLS on the Beats input (certificate from the internal CA; senders: vexor elk beats-config)
LOGSTASH_BEATS_TLS=true
N8N_PORT=55678
GRAFANA_PORT=53000
PORTAINER_PORT=59443

# ---- Credentials (generated when CHANGE_ME) ----------------------------------
INDEXER_USERNAME=admin
INDEXER_PASSWORD=CHANGE_ME
DASHBOARD_USERNAME=kibanaserver
DASHBOARD_PASSWORD=CHANGE_ME
API_USERNAME=wazuh-wui
API_PASSWORD=CHANGE_ME
ELASTIC_PASSWORD=CHANGE_ME
KIBANA_SYSTEM_PASSWORD=CHANGE_ME
LOGSTASH_ES_PASSWORD=CHANGE_ME
KIBANA_ENCRYPTION_KEY=CHANGE_ME
GRAFANA_ADMIN_PASSWORD=CHANGE_ME
GRAFANA_INDEXER_PASSWORD=CHANGE_ME
PORTAINER_ADMIN_PASSWORD=CHANGE_ME
N8N_ENCRYPTION_KEY=CHANGE_ME
# set by: vexor agents password on (fresh installs turn it on when ENROLL_PASSWORD_ON_INSTALL=yes)
AGENT_ENROLL_PASSWORD=
ENROLL_PASSWORD_ON_INSTALL=yes

# ---- Health notifications (vexor notify) --------------------------------------
# fail | warn | off
NOTIFY_ON=fail
# Slack / Teams / Discord incoming webhook or any JSON URL (empty + n8n connected = the n8n webhook)
NOTIFY_URL=
NOTIFY_REPEAT_HOURS=6

# ---- Vexor Console (web UI) ---------------------------------------------------
CONSOLE=true
# 50000-59999, HTTPS with the dashboard certificate
CONSOLE_PORT=50443
# address the console listens on (empty = BIND_IP)
CONSOLE_BIND=
CONSOLE_USER=admin
CONSOLE_PASSWORD=CHANGE_ME

# ---- n8n alert forwarding (vexor n8n connect / credentials) -----------------
# alerts with this level or higher go to n8n
N8N_ALERT_LEVEL=7
# set by: vexor n8n connect [path]   (internal URL, e.g. http://n8n:5678/webhook/vexor-alerts)
N8N_HOOK_URL=
# only these Wazuh rule groups, comma separated (empty = all)
N8N_ALERT_GROUPS=
# sent as X-Vexor-Token with every alert (generated)
N8N_HOOK_TOKEN=
# Wazuh API user for n8n workflows (vexor n8n credentials)
WAZUH_N8N_USER=vexor-n8n
WAZUH_N8N_PASSWORD=
ES_N8N_PASSWORD=CHANGE_ME
# workflow library (vexor n8n workflow): Slack/Teams/Discord/JSON webhook for alert messages
N8N_NOTIFY_URL=
# AbuseIPDB API key: adds an IP reputation score to alerts with a public source IP
N8N_ABUSEIPDB_KEY=
# off | approve = critical alerts with a public source IP ask in chat, then firewall-drop on the agent
N8N_AUTO_BLOCK=off

# ---- Optional tools (true | false) - vexor tools enable <name> ---------------
N8N=false
GRAFANA=false
PORTAINER=false
SURICATA=false
ZEEK=false
N8N_IMAGE=n8nio/n8n:2.40.0
GRAFANA_IMAGE=grafana/grafana-oss:13.0.2
PORTAINER_IMAGE=portainer/portainer-ce:2.45.1
SURICATA_IMAGE=jasonish/suricata:8.0.5
ZEEK_IMAGE=zeek/zeek:8.2.2
# interface Suricata/Zeek sniff (empty = interface of the default route)
SNIFF_INTERFACE=
# Zeek logs Wazuh reads (conn is very large - add it on purpose)
ZEEK_WAZUH_LOGS=notice,weird,dns,http,ssl,ssh

# ---- Sizing -------------------------------------------------------------------
INDEXER_HEAP=1g
ELK_HEAP=1g
LOGSTASH_HEAP=512m
NGINX_WORKER_CONNECTIONS=1024

# ---- Logs, retention, backups -------------------------------------------------
LOG_MAX_SIZE=50m
LOG_MAX_FILE=5
RETENTION_DAYS=30              # Wazuh alerts and ELK events older than this are deleted (0 = keep forever)
# INDEX_RETENTION_DAYS: optional Wazuh-only override of RETENTION_DAYS (empty = RETENTION_DAYS)
INDEX_RETENTION_DAYS=
MANAGER_LOG_RETENTION_DAYS=30
# ELK_RETENTION_DAYS: optional ELK-only override of RETENTION_DAYS (empty = RETENTION_DAYS)
ELK_RETENTION_DAYS=
TOOLS_LOG_RETENTION_DAYS=7
SNAPSHOT_RETENTION_DAYS=14
BACKUP_DIR=./backups

# ---- Dashboard / Kibana / tools certificate (vexor cert ...) -----------------
# default | local | custom | letsencrypt
PROXY_CERT_MODE=default
# extra names/IPs for the certificate, comma separated
CERT_EXTRA_SANS=
CERT_DAYS=397
LE_DOMAIN=
LE_EMAIL=

# ---- Automation (vexor daemon install) ----------------------------------------
BACKUP_TIME=01:30
MAINT_TIME=02:15
HEALTH_INTERVAL=1h
WATCHDOG_AUTOHEAL=yes
# doctor warns above this % used on any disk Docker uses, and fails above DISK_FAIL_PCT
DISK_WARN_PCT=85
DISK_FAIL_PCT=95
# install warns below DISK_WARN_FREE_GB free on a disk Docker uses and refuses below DISK_MIN_FREE_GB (vexor install --force overrides)
DISK_WARN_FREE_GB=15
DISK_MIN_FREE_GB=5
# true = Wazuh vulnerability detection in every manager. Off by default: its CVE feed needs about 13 GB of disk
# per manager (inside the *-wazuh-queue volume). Turning it off again deletes the downloaded feed.
WAZUH_VULN_DETECTION=false
CLEANUP_REMIND_DAYS=3
INDEXER_MOVE_TIMEOUT=3600
